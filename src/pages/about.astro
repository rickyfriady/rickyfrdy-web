---
import GitHubActivity from '@/components/about/GitHubActivity'
import GitHubHeatmap from '@/components/about/GitHubHeatmap'
import GitHubLanguages from '@/components/about/GitHubLanguages'
import GitHubPinnedRepos from '@/components/about/GitHubPinnedRepos'
import MainLayout from '@/components/layout/MainLayout.astro'
import CollaboratorsSection from '@/components/people/CollaboratorsSection.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import { fetchBuildTimeStats } from '@/utils/github'
import { getSkillIconUrl } from '@/utils/skillIcon'

const initialStats = await fetchBuildTimeStats(import.meta.env.GITHUB_TOKEN)

const stack = ['TypeScript', 'Vue 3', 'React', 'NestJS', 'Node.js', 'PostgreSQL', 'Redis', 'Docker']

const beyondCode = [
  { label: 'Solo travel', detail: 'Slow trips through Sumatra & Java — 4 provinces in 2025' },
  { label: 'Open source', detail: 'Contribute to small Vue + Astro tooling on weekends' },
  { label: 'Photography', detail: 'Manual lens shooter — Fujifilm X-T2 + 35mm prime' },
  { label: 'Reading', detail: 'Currently on Designing Data-Intensive Applications (slow re-read)' },
]
---

<MainLayout
  title="About — Ricki Friadi"
  description="Ricki Friadi — a fullstack developer in Jakarta. Story, current work, and the experience behind the systems."
>
  <PageAnimations />

  <!-- ─── Hero ─────────────────────────────────────────────────── -->
  <section class="border-border relative border-b px-4 py-12 md:py-20">
    <div class="paper-grid pointer-events-none absolute inset-0 opacity-30" aria-hidden="true" />

    <div class="relative grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end md:gap-16">
      <!-- Title block -->
      <div>
        <p class="eyebrow mb-4" data-hero-reveal>About</p>
        <h1
          class="title-display"
          style="font-size: clamp(2.4rem, 7vw, 5rem); line-height: 0.93"
          data-hero-reveal
        >
          A story of<br />
          <span class="title-accent text-accent">shipping things</span><br />
          that last.
        </h1>
        <p class="text-muted mt-6 max-w-md text-sm leading-relaxed" data-hero-reveal>
          Fullstack developer based in Jakarta. I build the systems behind Indonesian fintech —
          micro-frontends, NestJS microservices, and the architecture that keeps them
          maintainable at scale.
        </p>

        <!-- Quick metadata strip -->
        <dl class="text-muted mt-8 grid max-w-md grid-cols-3 gap-x-4 gap-y-2 border-t border-border/60 pt-5 font-mono text-[10px] uppercase tracking-[0.12em]" data-hero-reveal>
          <div>
            <dt class="opacity-50">Based</dt>
            <dd class="text-foreground mt-1">Jakarta, ID</dd>
          </div>
          <div>
            <dt class="opacity-50">Years</dt>
            <dd class="text-foreground mt-1">4+ in prod</dd>
          </div>
          <div>
            <dt class="opacity-50">Status</dt>
            <dd class="text-accent mt-1">Open to work</dd>
          </div>
        </dl>
      </div>

      <!-- Twin photo composition -->
      <div class="relative grid gap-3 sm:max-w-sm md:max-w-none" data-hero-reveal data-parallax-wrap>
        <div class="grid grid-cols-2 gap-3" data-parallax-target>
          <!-- Primary portrait -->
          <div
            class="relative aspect-[3/4] overflow-hidden rounded-lg border border-border bg-secondary"
          >
            <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <span
                class="font-display text-5xl font-bold leading-none"
                style="color: color-mix(in oklch, var(--color-accent) 35%, transparent)"
              >
                RF
              </span>
            </div>
            <img
              src="/images/avatar.jpg"
              alt="Ricki Friadi"
              width={400}
              height={533}
              loading="eager"
              class="absolute inset-0 h-full w-full object-cover object-top text-transparent"
            />
          </div>

          <!-- Scene / secondary -->
          <div
            class="relative aspect-[3/4] mt-8 overflow-hidden rounded-lg border border-border bg-secondary"
          >
            <!-- Fallback pattern when no scene.jpg exists -->
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-3" aria-hidden="true">
              <div class="grid grid-cols-3 gap-1.5 opacity-30">
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
                <div class="size-6 rounded-sm bg-accent/40" />
              </div>
              <span class="font-mono text-muted text-[10px] uppercase tracking-[0.15em]">
                Jakarta, ID
              </span>
            </div>
            <img
              src="/images/scene.jpg"
              alt="A scene from my work"
              width={400}
              height={533}
              loading="lazy"
              data-scene-img
              class="absolute inset-0 h-full w-full object-cover object-center"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── § 01 — Story ─────────────────────────────────────────── -->
  <section class="border-border border-b" data-stagger-group>
    <div class="chapter-heading px-4">
      <span class="chapter-label">§ 01 — Story</span>
    </div>

    <div class="max-w-prose space-y-5 px-4 pb-12 text-sm leading-relaxed" style="text-wrap: pretty">
      <p data-stagger-item>
        I started writing code in 2020 during a final-year thesis project — a Python chatbot that
        answered student questions about Universitas Riau's community service program. It hit
        80% match accuracy on a hand-curated 3,000-pair dataset and shipped to the administrative
        office. I thought I was done.
      </p>
      <p data-stagger-item>
        Then in April 2021, my first internship at PT. Sumatera Kalimantan Jaya gave me 14 days
        to ship a company profile site. CodeIgniter, PHP, deadline pressure. We shipped on time.
        That habit — <span class="text-foreground font-semibold">ship fast, iterate honestly</span>
        — has stayed with me ever since.
      </p>
      <p data-stagger-item>
        Two years of freelancing followed: React, Node.js, Express, integrating MongoDB, MySQL,
        and PostgreSQL for SMB clients across Pekanbaru. The work was unglamorous but it forced
        a kind of generalist fluency you can't get from one stack at one company.
      </p>
      <p data-stagger-item>
        I joined <span class="text-foreground font-semibold">PT. Pegadaian</span> in May 2023 as
        a Software Engineer. Since 2024 I've been deep in micro-frontends and microservices —
        migrating a CodeIgniter monolith to 9 NestJS services using the Factory pattern,
        contributing to a Module Federation platform that serves 1.5 million users, and
        maintaining ≥80% Vitest coverage on everything I ship.
      </p>
    </div>
  </section>

  <!-- ─── § 02 — Currently ─────────────────────────────────────── -->
  <section class="border-border border-b" data-stagger-group>
    <div class="chapter-heading px-4">
      <span class="chapter-label">§ 02 — Currently</span>
    </div>

    <div class="grid gap-10 px-4 pb-12 md:grid-cols-2">
      <div data-stagger-item>
        <p class="text-foreground text-sm font-semibold mb-3">Working on</p>
        <p class="text-muted text-sm leading-relaxed">
          Micro-frontend modules for Singel APP at Pegadaian, the Microsite Pinjaman Factory-pattern
          rewrite, and KAMILA's marketing performance reporting. I write a lot of Vitest specs.
        </p>
      </div>

      <div data-stagger-item>
        <p class="text-foreground text-sm font-semibold mb-3">Daily stack</p>
        <div class="flex flex-wrap gap-2 justify-start">
          {stack.map((t) => {
            const url = getSkillIconUrl(t)
            return url ? (
              <span class="inline-flex min-h-[44px] items-center gap-1.5 rounded-lg border border-border/40 bg-secondary/30 px-2.5 py-1.5 font-mono text-xs text-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2" aria-label={t}>
                <img src={url} alt="" aria-hidden="true" width="18" height="18" class="rounded-sm" loading="lazy" />
                {t}
              </span>
            ) : (
              <span class="diff-tag min-h-[44px] flex items-center" aria-label={t}>{t}</span>
            )
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── § 03 — Beyond Code ───────────────────────────────────── -->
  <section class="border-border border-b" data-stagger-group>
    <div class="chapter-heading px-4">
      <span class="chapter-label">§ 03 — Beyond code</span>
    </div>

    <div class="px-4 pb-12">
      <ul class="grid gap-x-10 gap-y-6 sm:grid-cols-2 max-w-3xl">
        {beyondCode.map((item) => (
          <li class="border-l-2 border-accent/40 pl-4" data-stagger-item>
            <p class="text-foreground text-sm font-semibold">{item.label}</p>
            <p class="text-muted mt-1 text-sm leading-relaxed">{item.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── § 04 — People I've worked with ───────────────────────── -->
  <CollaboratorsSection sectionLabel="§ 04 — People I've worked with" />

  <!-- ─── § 05 — GitHub ────────────────────────────────────────── -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <span class="chapter-label">§ 05 — GitHub</span>
    </div>

    <div class="grid gap-6 px-4 pb-12">
      <!-- Heatmap — full width -->
      <GitHubHeatmap client:visible initialStats={initialStats} />

      <!-- 2-col: Languages+PinnedRepos (left) | Activity (right) -->
      <div class="grid gap-6 md:grid-cols-2">
        <div class="space-y-6">
          <GitHubLanguages client:idle languages={initialStats.languages} />
          <GitHubPinnedRepos client:visible repos={initialStats.pinnedRepos} />
        </div>
        <GitHubActivity client:visible />
      </div>
    </div>
  </section>

  <!-- ─── CTA ──────────────────────────────────────────────────── -->
  <section class="px-4 py-16 text-center">
    <p class="eyebrow mb-4">Collaboration</p>
    <h2 class="title-display" style="font-size: clamp(1.8rem, 5vw, 3rem); line-height: 1">
      Let's build<br />
      <span class="title-accent text-accent">something together.</span>
    </h2>
    <p class="text-muted mx-auto mt-5 mb-8 max-w-sm text-sm leading-relaxed">
      Open to fullstack roles, freelance projects, or just a coffee chat about the systems
      problem you're stuck on.
    </p>
    <div class="flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href="/contact"
        class="bg-accent text-background hover:bg-accent-hover inline-flex min-h-[44px] items-center rounded-lg px-6 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        data-btn-hover
      >
        Get in touch
      </a>
      <a
        href="/projects"
        class="border-border text-foreground hover:bg-secondary inline-flex min-h-[44px] items-center rounded-lg border px-6 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        data-btn-hover
      >
        See my projects
      </a>
    </div>
  </section>
</MainLayout>
