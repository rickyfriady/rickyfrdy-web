---
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import ArtCredits from '@/components/game/ArtCredits.astro'
import Valley from '@/components/game/Valley.astro'
import { t } from '@/i18n/ui'
import { webPageSchema } from '@/utils/schema'

const lang = 'en'
---

<MainLayout
  title={t(lang, 'game.title')}
  description={t(lang, 'game.description')}
  lang="en"
  hreflangPairs={[
    { lang: 'en', href: 'https://rickyfrdy.my.id/play/' },
    { lang: 'id', href: 'https://rickyfrdy.my.id/id/play/' }
  ]}
  schema={webPageSchema(t(lang, 'game.title'), t(lang, 'game.description'), 'https://rickyfrdy.my.id/play/')}
>
  <PageAnimations />

  <section class="border-border border-b px-4 py-8">
    <p class="eyebrow mb-3">{t(lang, 'case.play')}</p>
    <h1 class="title-display" style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93">
      {t(lang, 'game.heading')}<span class="title-accent text-accent">.</span>
    </h1>
    <p class="text-muted mt-4 max-w-2xl text-sm leading-relaxed">{t(lang, 'game.intro')}</p>
    <a href="/board" class="menu-cursor text-accent mt-4 inline-block font-mono text-xs">
      {t(lang, 'case.board')} →
    </a>
  </section>

  <Valley lang={lang} showcase />

  <ArtCredits label={t(lang, 'game.artCredits')} />
</MainLayout>
