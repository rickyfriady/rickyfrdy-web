---
import { education, experiences, projects, skillCategories } from '@/data/experience'
import FinLogo from '@/components/ui/FinLogo.astro'
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import { webPageSchema } from '@/utils/schema'
import ProjectsAccordion from '@/components/experience/ProjectsAccordion.astro'
import { getSkillIconUrl } from '@/utils/skillIcon'
---

<MainLayout
  title="Experience — Ricki Friadi"
  description="Work history, projects, education, and skills of Ricki Friadi — Software Engineer at PT. Pegadaian since May 2023."
  lang="en"
  hreflangPairs={[
    { lang: 'en', href: 'https://rickyfrdy.my.id/experience/' },
    { lang: 'id', href: 'https://rickyfrdy.my.id/id/experience/' },
  ]}
  schema={webPageSchema('Experience — Ricki Friadi', 'Work history, projects, education, and skills of Ricki Friadi — Software Engineer at PT. Pegadaian since May 2023.', 'https://rickyfrdy.my.id/experience/')}
>
  <PageAnimations />

  <!-- Hero -->
  <section class="border-border border-b px-4 py-8">
    <p class="eyebrow mb-3">Record</p>
    <h1
      class="title-display"
      style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93"
    >
      Career, Projects &amp;<br />
      <span class="title-accent text-accent">Skills.</span>
    </h1>
    <p class="text-muted mt-4 text-sm leading-relaxed">
      Software Engineer at PT. Pegadaian since May 2023, working across microservices, micro-frontends, and internal tooling.
    </p>
  </section>

  <!-- CASE 01 · Work Experience -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <span class="chapter-label">CASE 01 · Work Experience</span>
    </div>

    <div class="px-4 pb-12">
      <ol class="space-y-12">
        {experiences.map((exp) => (
          <li class="grid gap-4 md:grid-cols-[200px_1fr] md:gap-10">
            <!-- Left column: period + company badge -->
            <div class="flex items-start gap-3 md:flex-col md:gap-4">
              {exp.companyLogo ? (
                <FinLogo name={exp.companyLogo} size={40} bg label={exp.company} />
              ) : (
                <div class="size-10 flex-shrink-0 rounded-full border border-border bg-secondary flex items-center justify-center">
                  <span class="text-accent font-display text-base font-bold leading-none">
                    {exp.company.charAt(0)}
                  </span>
                </div>
              )}
              <div>
                <p class="text-muted font-mono text-[10px] uppercase tracking-[0.12em] leading-snug">
                  {exp.period}
                </p>
                <p class="text-muted mt-1 font-mono text-[10px] uppercase tracking-[0.08em] opacity-70 leading-snug">
                  {exp.location}
                </p>
              </div>
            </div>

            <!-- Right column: role + bullets + stack -->
            <div>
              <p class="text-foreground text-base font-semibold leading-snug">
                {exp.role}
              </p>
              <p class="text-accent mt-1 font-mono text-xs tracking-[0.1em]">
                {exp.company}
              </p>

              <ul class="text-muted mt-4 space-y-3 text-sm leading-relaxed">
                {exp.bullets.map((b) => (
                  <li class="flex gap-3">
                    <span class="text-accent/60 mt-2 size-1 flex-shrink-0 rounded-full bg-current" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2 justify-start">
                {exp.stack.map((s) => {
                  const url = getSkillIconUrl(s)
                  return url ? (
                    <span class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border/40 bg-secondary/30 px-3 py-2 font-mono text-xs text-muted sm:gap-2 sm:px-3 sm:py-2 sm:text-[13px]" aria-label={s}>
                      <img src={url} alt="" aria-hidden="true" width="18" height="18" class="rounded-sm sm:h-5 sm:w-5" loading="lazy" />
                      {s}
                    </span>
                  ) : (
                    <span class="diff-tag min-h-[44px] flex items-center" aria-label={s}>{s}</span>
                  )
                })}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CASE 02 · Project Experience -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <span class="chapter-label">CASE 02 · Project Experience</span>
    </div>

    <div class="px-4">
      <ProjectsAccordion projects={projects} />
    </div>
  </section>

  <!-- CASE 03 · Education -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <span class="chapter-label">CASE 03 · Education</span>
    </div>

    <div class="px-4 pb-8">
      <div class="flex flex-wrap items-baseline gap-2">
        <span class="text-foreground font-semibold">{education.degree}</span>
        <span class="diff-tag">{education.institution}</span>
      </div>
      <p class="text-muted mt-1 text-xs">{education.location} · {education.period}</p>
      <p class="text-muted mt-2 text-sm">GPA: <span class="text-foreground font-semibold">{education.gpa}</span></p>
    </div>
  </section>

  <!-- CASE 04 · Skills -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <span class="chapter-label">CASE 04 · Skills</span>
    </div>

    <div class="px-4 pb-8">
      {
        skillCategories.map((cat) => (
          <div class="mb-6">
            <p class="text-muted mb-2 font-mono text-[10px] tracking-[0.16em] uppercase">
              {cat.label}
            </p>
            <div class="flex flex-wrap gap-2 justify-start">
              {cat.items.map((item) => {
                const url = getSkillIconUrl(item)
                return url ? (
                  <span class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border/40 bg-secondary/30 px-3 py-2 font-mono text-xs text-muted sm:gap-2 sm:px-3 sm:py-2 sm:text-[13px]" aria-label={item}>
                    <img src={url} alt="" aria-hidden="true" width="18" height="18" class="rounded-sm sm:h-5 sm:w-5" loading="lazy" />
                    {item}
                  </span>
                ) : (
                  <span class="diff-tag min-h-[44px] flex items-center" aria-label={item}>{item}</span>
                )
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</MainLayout>
