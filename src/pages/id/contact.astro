---
import ContactFormSection from '@/components/contact/ContactFormSection.astro'
import ContactHero from '@/components/contact/ContactHero.astro'
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import { webPageSchema } from '@/utils/schema'
---

<MainLayout
  title="Kontak — Ricki Friadi"
  description="Hubungi Ricki Friadi — terbuka untuk peran fullstack, proyek freelance, dan kolaborasi."
  lang="id"
  hreflangPairs={[
    { lang: 'en', href: 'https://rickyfrdy.my.id/contact/' },
    { lang: 'id', href: 'https://rickyfrdy.my.id/id/contact/' },
  ]}
  schema={webPageSchema('Kontak — Ricki Friadi', 'Hubungi Ricki Friadi — terbuka untuk peran fullstack, proyek freelance, dan kolaborasi.', 'https://rickyfrdy.my.id/id/contact/')}
>
  <PageAnimations />

  <ContactHero
    eyebrow="Kontak"
    headingLine1="Mari Bangun"
    headingLine2="Sesuatu Bersama."
    subtitle="Terbuka untuk peran fullstack, proyek freelance, dan kolaborasi menarik. Kirim pesan dan saya akan membalas dalam beberapa hari."
  />

  <!-- CASE 01 · Form -->
  <section class="border-border border-b">
    <ContactFormSection sectionLabel="CASE 01 · Kirim Pesan" />
  </section>
</MainLayout>
