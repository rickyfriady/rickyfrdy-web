---
import ContactFormSection from '@/components/contact/ContactFormSection'
import ContactHero from '@/components/contact/ContactHero'
import MainLayout from '@/components/layout/MainLayout.astro'
---

<MainLayout
  title="Kontak — Ricki Friadi"
  description="Hubungi Ricki Friadi — terbuka untuk peran fullstack, proyek freelance, dan kolaborasi."
  lang="id"
>
  <ContactHero
    client:load
    eyebrow="Kontak"
    headingLine1="Mari Bangun"
    headingLine2="Sesuatu Bersama."
    subtitle="Terbuka untuk peran fullstack, proyek freelance, dan kolaborasi menarik. Kirim pesan dan saya akan membalas dalam beberapa hari."
  />

  <!-- § 01 — Form -->
  <section class="border-border border-b">
    <ContactFormSection client:visible sectionLabel="§ 01 — Kirim Pesan" />
  </section>
</MainLayout>
