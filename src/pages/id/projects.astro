---
import ProjectsGrid from '@/components/projects/ProjectsGrid'
import MainLayout from '@/components/layout/MainLayout.astro'
import { projects } from '@/data/projects'
---

<MainLayout
  title="Proyek — Ricki Friadi"
  description="Jelajahi portofolio aplikasi web dan solusi fullstack yang dibangun oleh Ricki Friadi — Vue 3, TypeScript, NestJS, PostgreSQL."
  lang="id"
>
  <!-- Hero -->
  <section class="border-border border-b px-4 py-8">
    <p class="eyebrow mb-3">Portofolio</p>
    <h1
      class="title-display"
      style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93"
    >
      Proyek &amp; Studi<br />
      <span class="title-accent text-accent">Kasus.</span>
    </h1>
    <p class="text-muted mt-4 text-sm leading-relaxed">
      Sistem dunia nyata dan pengalaman produk yang dibangun dengan pendekatan backend-first yang mementingkan performa.
    </p>
  </section>

  <!-- Projects grid with filters -->
  <section class="px-4 py-8">
    <ProjectsGrid projects={projects} client:load />
  </section>
</MainLayout>
