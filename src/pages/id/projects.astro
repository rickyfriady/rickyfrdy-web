---
import ProjectsGrid from '@/components/projects/ProjectsGrid.astro'
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import { webPageSchema } from '@/utils/schema'
import { projects } from '@/data/projects'
---

<MainLayout
  title="Proyek — Ricki Friadi"
  description="Jelajahi portofolio aplikasi web dan solusi fullstack yang dibangun oleh Ricki Friadi — Vue 3, TypeScript, NestJS, PostgreSQL."
  lang="id"
  hreflangPairs={[
    { lang: 'en', href: 'https://rickyfrdy.my.id/projects/' },
    { lang: 'id', href: 'https://rickyfrdy.my.id/id/projects/' },
  ]}
  schema={webPageSchema('Proyek — Ricki Friadi', 'Jelajahi portofolio aplikasi web dan solusi fullstack yang dibangun oleh Ricki Friadi — Vue 3, TypeScript, NestJS, PostgreSQL.', 'https://rickyfrdy.my.id/id/projects/')}
>
  <PageAnimations />

  <!-- Hero -->
  <section class="border-border border-b px-4 py-8">
    <p class="eyebrow mb-3">Barang Bukti</p>
    <h1
      class="title-display"
      style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93"
    >
      Proyek &amp;<br />
      <span class="title-accent text-accent">Karya.</span>
    </h1>
    <p class="text-muted mt-4 text-sm leading-relaxed">
      Sistem produksi dan eksperimen sampingan — dibangun dengan pendekatan backend-first yang mementingkan performa.
    </p>
  </section>

  <!-- Projects grid with filters -->
  <section class="px-4 py-8">
    <ProjectsGrid projects={projects} lang="id" />
  </section>
</MainLayout>
