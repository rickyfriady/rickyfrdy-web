---
import MainLayout from '@/components/layout/MainLayout.astro'
import { localizePath } from '@/i18n/path'
import { t } from '@/i18n/ui'
import { webPageSchema } from '@/utils/schema'
import FeaturedProjectCard from '@/components/projects/FeaturedProjectCard.astro'
import HeroPhoto from '@/components/ui/HeroPhoto.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import Valley from '@/components/game/Valley.astro'
import { projects } from '@/data/projects'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const featuredProjects = projects.slice(0, 3)

const recentPosts = (await getCollection('blog') as CollectionEntry<'blog'>[])
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2)

const categoryLabel: Record<string, string> = {
  'web-app': 'Web App',
  api: 'API',
  tool: 'Tool',
  'open-source': 'Open Source',
}

// The old capability chips, deduplicated: one scannable line, nothing added.
const stack = [
  'Vue 3', 'React', 'Astro', 'TypeScript', 'Tailwind', 'NestJS', 'Node.js', 'PostgreSQL', 'Redis',
  'Express', 'Microservices', 'Module Federation', 'Zod', 'Docker', 'GitLab CI',
]
---

<MainLayout
  title="Ricki Friadi, Fullstack Developer"
  description="Fullstack Developer specializing in Vue 3, NestJS microservices, and Micro-Frontend Architecture. Based in Jakarta, Indonesia."
  lang="en"
  hreflangPairs={[
    { lang: 'en', href: 'https://rickyfrdy.my.id/' },
    { lang: 'id', href: 'https://rickyfrdy.my.id/id/' },
  ]}
  schema={webPageSchema('Ricki Friadi, Fullstack Developer', 'Fullstack Developer specializing in Vue 3, NestJS microservices, and Micro-Frontend Architecture. Based in Jakarta, Indonesia.', 'https://rickyfrdy.my.id/')}
>
  <PageAnimations />

  <!-- ─── Hero ─────────────────────────────────────────────────── -->
  <section class="border-border relative border-b px-4 py-12 md:py-16">
    <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-start md:gap-16">
      <!-- Left: text -->
      <div class="md:max-w-3xl">
        <p class="eyebrow mb-4" data-hero-reveal>{t('en', 'hero.eyebrow')}</p>
        <h1
          class="title-display max-w-3xl"
          style="font-size: clamp(3rem, 10vw, 6.5rem); line-height: 0.92"
          data-hero-reveal
        >
          Ricki<br />
          <span class="title-accent text-accent">Friadi.</span>
        </h1>
        <p class="text-foreground mt-6 max-w-2xl text-lg leading-relaxed md:text-xl" data-hero-reveal>
          At PT. Pegadaian, a state-owned lender, I led the Module Federation front-end that 5+
          teams deploy on their own. I also designed the 9 NestJS microservices that replaced a
          legacy monolith with zero downtime.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap gap-3" data-hero-reveal>
          <a
            href="/projects"
            class="menu-cursor bg-accent text-background hover:bg-accent-hover inline-flex min-h-[44px] items-center px-6 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            data-btn-hover
          >
            View My Work
          </a>
          <a
            href="/contact"
            class="menu-cursor border-border text-foreground hover:bg-secondary inline-flex min-h-[44px] items-center border-2 px-6 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            data-btn-hover
          >
            Get in Touch
          </a>
        </div>
        <!-- The document a recruiter came for, one quiet step below the two CTAs. -->
        <a
          href={localizePath('/resume.pdf', 'en')}
          class="text-muted hover:text-accent mt-2 inline-flex min-h-11 items-center font-mono text-xs transition-colors"
          data-hero-reveal
        >
          {t('en', 'hero.resume')}
        </a>
      </div>

      <!-- Right: avatar -->
      <HeroPhoto lang="en" />
    </div>
  </section>

  <!-- ─── The valley: every page as a place, list first ───────── -->
  <Valley
    lang="en"
    linkedElsewhere={[
      ...featuredProjects.map((p) => `/projects/${p.slug}`),
      ...recentPosts.map((post) => `/blog/${post.id}`)
    ]}
  />

  <!-- ─── 01 · Selected Work ─────────────────────────────────── -->
  <section class="border-border border-b" data-stagger-group>
    <div class="chapter-heading px-4">
      <h2 class="chapter-label inline">01 · Selected Work</h2>
    </div>

    <div class="grid grid-cols-1 gap-4 px-4 pb-2 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project) => (
        <div data-stagger-item>
          <FeaturedProjectCard
            project={project}
            categoryLabel={categoryLabel[project.category] ?? project.category}
            featuredLabel="Featured"
            locale="en-US"
          />
        </div>
      ))}
    </div>

    <div class="px-4 pb-8">
      <a
        href="/projects"
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        All projects →
      </a>
    </div>
  </section>

  <!-- ─── 02 · Stack ─────────────────────────────────────────── -->
  <section class="border-border border-b">
    <div class="chapter-heading px-4">
      <h2 class="chapter-label inline">02 · Stack</h2>
    </div>
    <p class="text-foreground max-w-4xl px-4 pb-8 text-sm leading-relaxed">{stack.join(' · ')}</p>
  </section>

  <!-- ─── 03 · Recent Writing ────────────────────────────────── -->
  {recentPosts.length > 0 && (
    <section class="border-border border-b" data-stagger-group>
      <div class="chapter-heading px-4">
        <h2 class="chapter-label inline">03 · Recent Writing</h2>
      </div>

      <div class="divide-border divide-y px-4">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block py-6 no-underline"
            data-stagger-item
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <h3 class="text-foreground group-hover:text-accent text-base font-semibold transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-muted mt-1 line-clamp-1 text-sm leading-relaxed">
                  {post.data.description}
                </p>
              </div>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="text-muted flex-shrink-0 font-mono text-xs"
              >
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </time>
            </div>
          </a>
        ))}
      </div>

      <div class="px-4 pb-8">
        <a
          href="/blog"
          class="inline-flex min-h-11 min-w-11 items-center justify-center text-muted hover:text-accent font-mono text-xs transition-colors"
        >
          All articles →
        </a>
      </div>
    </section>
  )}

  <!-- ─── 04 · Open to Work ──────────────────────────────────── -->
  <section class="border-border border-b px-4 py-12">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="eyebrow mb-2">Availability</p>
        <h2
          class="title-display"
          style="font-size: clamp(1.8rem, 4vw, 3rem); line-height: 0.95"
        >
          Open to<br />
          <span class="title-accent text-accent">New Roles.</span>
        </h2>
        <p class="text-muted mt-3 max-w-md text-sm leading-relaxed">
          Looking for fullstack or backend-focused positions. Strong preference for TypeScript,
          Vue / React, and NestJS stacks. Remote or Jakarta-based. Also open to freelance projects:
          a whole system, front end to back end, from one person.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/contact"
          class="menu-cursor bg-accent text-background hover:bg-accent-hover inline-flex min-h-11 py-2 items-center px-6 text-sm font-medium transition-colors"
          data-btn-hover
        >
          Start a Conversation
        </a>
        <a
          href="/experience"
          class="menu-cursor border-border text-foreground hover:bg-secondary inline-flex min-h-11 py-2 items-center border-2 px-6 text-sm font-medium transition-colors"
          data-btn-hover
        >
          View Experience
        </a>
      </div>
    </div>
  </section>
</MainLayout>
