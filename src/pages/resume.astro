---
import { education, experiences, projects, skillCategories, summary } from '@/data/experience'
import FinLogo from '@/components/ui/FinLogo.astro'
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import ResumeSkeleton from '@/components/resume/ResumeSkeleton.astro'
import { webPageSchema } from '@/utils/schema'
---

<MainLayout
  title="Resume — Ricki Friadi"
  description="Fullstack Developer resume — Ricki Friadi. 4+ years building production systems in Indonesian fintech."
  lang="en"
  schema={webPageSchema('Resume — Ricki Friadi', 'Fullstack Developer resume — Ricki Friadi. 4+ years building production systems in Indonesian fintech.', 'https://rickyfrdy.my.id/resume/')}
>
  <PageAnimations />

  <ResumeSkeleton />

  <div id="resume-content" class="mx-auto max-w-2xl px-4 py-12">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="font-display text-4xl font-light tracking-tight">Ricki Friadi</h1>
      <p class="text-muted mt-1 text-sm">Fullstack Developer</p>
      <div class="text-muted mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
        <span>Jakarta, Indonesia</span>
        <a href="mailto:friadi.ricki@gmail.com" class="text-accent hover:underline">friadi.ricki@gmail.com</a>
        <a
          href="https://github.com/rickyfriady"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ricki Friadi on GitHub"
          class="text-accent hover:underline"
        >github.com/rickyfriady</a>
      </div>
    </div>

    <hr class="border-border mb-8" />

    <!-- Summary -->
    <section class="mb-8">
      <h2 class="text-muted mb-3 font-mono text-[10px] tracking-[0.16em] uppercase">Summary</h2>
      <p class="text-foreground text-sm leading-relaxed">{summary}</p>
    </section>

    <hr class="border-border mb-8" />

    <!-- Work Experience -->
    <section class="mb-8">
      <h2 class="text-muted mb-4 font-mono text-[10px] tracking-[0.16em] uppercase">Work Experience</h2>
      <div class="space-y-8">
        {experiences.map((exp) => (
          <div>
            <div class="flex flex-wrap items-center gap-2">
              {exp.companyLogo && <FinLogo name={exp.companyLogo} size={22} bg label={exp.company} />}
              <span class="text-foreground font-semibold text-sm">{exp.role}</span>
              <span class="diff-tag">{exp.company}</span>
            </div>
            <p class="text-muted mt-1 text-xs">{exp.location} · {exp.period}</p>
            <ul class="mt-3 space-y-2">
              {exp.bullets.map((bullet) => (
                <li class="flex gap-2 text-sm">
                  <span class="text-accent mt-1 flex-shrink-0 text-xs">›</span>
                  <span class="text-muted">{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex flex-wrap gap-2">
              {exp.stack.map((tech) => (
                <span class="diff-tag">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Project Experience -->
    <section class="mb-8">
      <h2 class="text-muted mb-4 font-mono text-[10px] tracking-[0.16em] uppercase">Project Experience</h2>
      <div class="space-y-8">
        {projects.map((proj) => (
          <div>
            <div class="flex flex-wrap items-center gap-2">
              {proj.companyLogo && <FinLogo name={proj.companyLogo} size={22} bg label={proj.company} />}
              <span class="text-foreground font-semibold text-sm">{proj.title}</span>
              <span class="diff-tag">{proj.company}</span>
            </div>
            <p class="text-muted mt-1 text-xs">{proj.period}</p>
            <ul class="mt-3 space-y-2">
              {proj.bullets.map((bullet) => (
                <li class="flex gap-2 text-sm">
                  <span class="text-accent mt-1 flex-shrink-0 text-xs">›</span>
                  <span class="text-muted">{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex flex-wrap gap-2">
              {proj.stack.map((tech) => (
                <span class="diff-tag">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Education -->
    <section class="mb-8">
      <h2 class="text-muted mb-4 font-mono text-[10px] tracking-[0.16em] uppercase">Education</h2>
      <div>
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-foreground font-semibold text-sm">{education.degree}</span>
          <span class="diff-tag">{education.institution}</span>
        </div>
        <p class="text-muted mt-1 text-xs">{education.location} · {education.period}</p>
        <p class="text-muted mt-2 text-sm">GPA: <span class="text-foreground font-semibold">{education.gpa}</span></p>
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Skills -->
    <section class="mb-12">
      <h2 class="text-muted mb-4 font-mono text-[10px] tracking-[0.16em] uppercase">Skills</h2>
      <div class="space-y-4">
        {skillCategories.map((cat) => (
          <div>
            <h3 class="text-muted mb-2 font-mono text-[10px] tracking-[0.16em] uppercase">{cat.label}</h3>
            <div class="flex flex-wrap gap-2">
              {cat.items.map((item) => (
                <span class="diff-tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Download CTA -->
    <div class="pb-4 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/resume.pdf"
        download
        class="bg-accent/10 text-accent border-accent/30 hover:bg-accent/20 inline-flex items-center gap-2 rounded-md border px-4 py-2 font-mono text-sm transition-colors"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download PDF
      </a>
      <a
        href="/resume-ats.pdf"
        download
        class="text-muted border-border hover:bg-secondary inline-flex items-center gap-2 rounded-md border px-4 py-2 font-mono text-xs transition-colors"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        ATS Version
      </a>
    </div>

  </div>

  <script>
    function swapInSkeleton(contentId: string, templateId: string) {
      const content = document.getElementById(contentId)
      const template = document.getElementById(templateId)
      if (!content || !template || content.dataset.skeletonActive === 'true') return
      content.dataset.skeletonActive = 'true'
      content.style.display = 'none'
      const clone = template.cloneNode(true) as HTMLElement
      clone.removeAttribute('hidden')
      clone.id = `${templateId}-clone`
      content.insertAdjacentElement('afterend', clone)
    }

    function restoreContent(contentId: string, templateId: string) {
      const content = document.getElementById(contentId)
      const clone = document.getElementById(`${templateId}-clone`)
      if (!content) return
      content.style.display = ''
      delete content.dataset.skeletonActive
      if (clone) {
        clone.style.transition = 'opacity 200ms ease'
        clone.style.opacity = '0'
        setTimeout(() => clone.remove(), 200)
      }
    }

    document.addEventListener('astro:after-swap', () => {
      if (location.pathname.replace(/\/$/, '') === '/resume') {
        swapInSkeleton('resume-content', 'resume-skeleton-template')
      }
    })

    document.addEventListener('astro:page-load', () => {
      requestAnimationFrame(() => restoreContent('resume-content', 'resume-skeleton-template'))
    })
  </script>
</MainLayout>
