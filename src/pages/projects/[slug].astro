---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import CaseStudyHero from '@/components/projects/CaseStudyHero.astro'
import MetricCounters from '@/components/projects/MetricCounters.astro'
import ProjectCTAs from '@/components/projects/ProjectCTAs.astro'
import ProjectNav from '@/components/projects/ProjectNav.astro'
import MainLayout from '@/components/layout/MainLayout.astro'
import { projects } from '@/data/projects'
import type { Project } from '@/models'
import { t } from '@/i18n/ui'
import { creativeWorkSchema } from '@/utils/schema'

export const getStaticPaths: GetStaticPaths = async () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

const { project } = Astro.props as { project: Project }
const lang = 'en'
const canonicalUrl = new URL(`/projects/${project.slug}/`, Astro.site).toString()
const ogImageUrl = new URL(`/og/projects/${project.slug}.png`, Astro.site).toString()

const projectEntries = (await getCollection('projects')) as CollectionEntry<'projects'>[]
const mdxEntry = projectEntries.find((e: CollectionEntry<'projects'>) => e.data.slug === project.slug)
const Content = mdxEntry ? (await render(mdxEntry)).Content : null

const idx = projects.findIndex((p) => p.slug === project.slug)
const prev = projects.length > 1 ? projects[(idx - 1 + projects.length) % projects.length] : null
const next = projects.length > 1 ? projects[(idx + 1) % projects.length] : null

const pairs = project.challenges
  .slice(0, Math.min(project.challenges.length, project.solutions.length))
  .map((challenge, i) => ({ challenge, solution: project.solutions[i] }))
---

<MainLayout
  title={`${project.title} — Ricki Friadi`}
  description={project.shortDescription}
  ogImage={`/og/projects/${project.slug}.png`}
  schema={creativeWorkSchema(project, canonicalUrl, ogImageUrl)}
  noReveal
>
  <!-- Back link -->
  <div class="border-border border-b px-6 py-3 md:px-16">
    <a
      href="/projects"
      class="text-muted hover:text-foreground font-mono text-xs tracking-[0.15em] uppercase transition-colors"
    >
      {t(lang, 'case.back')}
    </a>
  </div>

  <!-- Hero -->
  <CaseStudyHero project={project} />

  <!-- § Role + Tech + CTAs -->
  <section class="border-border border-b" data-reveal>
    <div class="px-6 py-12 md:px-16 md:py-14">

      {project.role && (
        <div class="mb-6 flex flex-wrap items-baseline gap-3">
          <span class="font-mono text-[10px] tracking-[0.22em] uppercase text-accent">
            {t(lang, 'case.role')}
          </span>
          <span class="text-foreground text-sm">{project.role}</span>
        </div>
      )}

      <div class="mb-8 flex flex-wrap gap-1.5">
        {project.technologies.map((tech) => (
          <span class="diff-tag" data-tech-chip>{tech}</span>
        ))}
      </div>

      <ProjectCTAs
        liveUrl={project.liveUrl}
        githubUrl={project.githubUrl}
        liveLabel={t(lang, 'case.live')}
        githubLabel={t(lang, 'case.github')}
      />
    </div>
  </section>

  <!-- § Overview -->
  <section class="border-border border-b" data-reveal>
    <div class="px-6 py-12 md:px-16 md:py-14">
      <p class="font-mono mb-6 text-[10px] tracking-[0.25em] uppercase text-accent/70">
        {t(lang, 'case.overview')}
      </p>
      <h2 class="text-foreground text-xl font-semibold leading-snug mb-5 max-w-2xl md:text-2xl">
        {project.shortDescription}
      </h2>
      {Content ? (
        <div class="prose prose-sm text-foreground max-w-2xl leading-relaxed [&_strong]:text-foreground">
          <Content />
        </div>
      ) : (
        <p class="text-muted max-w-2xl text-sm leading-relaxed">{project.fullDescription}</p>
      )}
    </div>
  </section>

  <!-- § Impact metrics -->
  {project.metrics && project.metrics.length > 0 && (
    <section class="border-border border-b" data-reveal>
      <div class="px-6 py-12 md:px-16 md:py-14">
        <p class="font-mono mb-8 text-[10px] tracking-[0.25em] uppercase text-accent/70">
          {t(lang, 'case.impact')}
        </p>
        <MetricCounters metrics={project.metrics} />
      </div>
    </section>
  )}

  <!-- § Problem → Solution -->
  <section class="border-border border-b" data-reveal>
    <div class="px-6 py-12 md:px-16 md:py-14">
      <p class="font-mono mb-10 text-[10px] tracking-[0.25em] uppercase text-accent/70">
        {t(lang, 'case.problem')} → {t(lang, 'case.solution')}
      </p>

      <div class="space-y-10">
        {pairs.map((pair) => (
          <div class="grid gap-0 sm:grid-cols-[1fr_40px_1fr]" data-pair>
            <!-- Challenge -->
            <div class="pb-6 sm:pb-0 sm:pr-8">
              <p class="font-mono mb-3 text-[9px] tracking-[0.25em] uppercase text-muted">
                {t(lang, 'case.problem')}
              </p>
              <p class="text-foreground text-sm leading-relaxed">{pair.challenge}</p>
            </div>

            <!-- Connector -->
            <div class="hidden sm:flex flex-col items-center pt-8">
              <div class="h-full w-px bg-border/50 relative">
                <span
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
                         bg-background text-accent font-mono text-xs px-1"
                >
                  →
                </span>
              </div>
            </div>

            <!-- Solution -->
            <div class="border-t border-border pt-6 sm:border-0 sm:pt-0 sm:pl-8">
              <p class="font-mono mb-3 text-[9px] tracking-[0.25em] uppercase text-muted">
                {t(lang, 'case.solution')}
              </p>
              <p class="text-foreground text-sm leading-relaxed">{pair.solution}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- § Key highlights -->
  <section class="border-border border-b" data-reveal>
    <div class="px-6 py-12 md:px-16 md:py-14">
      <p class="font-mono mb-8 text-[10px] tracking-[0.25em] uppercase text-accent/70">
        {t(lang, 'case.highlights')}
      </p>
      <ul class="space-y-4 max-w-2xl">
        {project.results.map((result, i) => (
          <li class="flex gap-4 text-sm leading-relaxed" data-result>
            <span class="text-accent font-mono text-xs mt-0.5 flex-shrink-0 select-none">
              0{i + 1}
            </span>
            <span class="text-foreground">{result}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- § Prev / Next -->
  <ProjectNav
    prev={prev}
    next={next}
    prevLabel={t(lang, 'case.prev')}
    nextLabel={t(lang, 'case.next')}
  />
</MainLayout>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initAnimations() {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      // ── Hero ──────────────────────────────────────────────────────

      // 1. Background image: scale-in entrance + parallax on scroll
      const heroBg = document.querySelector<HTMLElement>('[data-hero-bg]')
      if (heroBg) {
        gsap.from(heroBg, {
          scale: 1.12,
          duration: 1.8,
          ease: 'power3.out',
        })
        gsap.to(heroBg, {
          yPercent: 28,
          ease: 'none',
          scrollTrigger: {
            trigger: '[data-hero]',
            start: 'top top',
            end: 'bottom top',
            scrub: 1.2,
          },
        })
      }

      // 2. Title: slide up from inside overflow:hidden parent (clip reveal)
      const heroTitle = document.querySelector<HTMLElement>('[data-hero-title]')
      if (heroTitle) {
        gsap.from(heroTitle, {
          y: '110%',
          duration: 1.1,
          ease: 'power4.out',
          delay: 0.1,
        })
      }

      // 3. Metadata items: stagger fade + rise
      const heroItems = document.querySelectorAll<HTMLElement>('[data-hero-item]')
      gsap.to(heroItems, {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        duration: 0.75,
        ease: 'power3.out',
        delay: 0.65,
      })

      // ── Sections: clip-path reveal ─────────────────────────────────
      document.querySelectorAll('[data-reveal]').forEach((section) => {
        gsap.from(section, {
          opacity: 0,
          y: 40,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 88%',
          },
        })
      })

      // ── Tech chips: back.out stagger ──────────────────────────────
      const techChips = document.querySelectorAll<HTMLElement>('[data-tech-chip]')
      if (techChips.length) {
        gsap.from(techChips, {
          opacity: 0,
          y: 14,
          scale: 0.85,
          stagger: 0.04,
          duration: 0.5,
          ease: 'back.out(1.5)',
          scrollTrigger: {
            trigger: techChips[0],
            start: 'top 88%',
          },
        })
      }

      // ── Problem / Solution: alternating x-entrance ────────────────
      document.querySelectorAll<HTMLElement>('[data-pair]').forEach((pair) => {
        const children = [...pair.children] as HTMLElement[]
        if (!children.length) return
        gsap.from(children, {
          opacity: 0,
          x: (i) => (i === 0 ? -24 : i === 2 ? 24 : 0),
          duration: 0.7,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: pair,
            start: 'top 86%',
          },
        })
      })

      // ── Result items: stagger from left ──────────────────────────
      const resultItems = document.querySelectorAll<HTMLElement>('[data-result]')
      if (resultItems.length) {
        gsap.from(resultItems, {
          opacity: 0,
          x: -20,
          stagger: 0.1,
          duration: 0.6,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: resultItems[0],
            start: 'top 88%',
          },
        })
      }
    })
  }

  initAnimations()

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill())
  })

  document.addEventListener('astro:after-swap', () => {
    if (document.querySelector('#case-study-hero-title')) {
      initAnimations()
    }
  })
</script>
