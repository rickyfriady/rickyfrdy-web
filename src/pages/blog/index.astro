---
import MainLayout from '@/components/layout/MainLayout.astro'
import PageAnimations from '@/components/ui/PageAnimations.astro'
import BlogGrid from '@/components/blog/BlogGrid.astro'
import BlogListSkeleton from '@/components/blog/BlogListSkeleton.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const posts = ((await getCollection('blog')) as CollectionEntry<'blog'>[])
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<MainLayout
  title="Blog — Ricki Friadi"
  description="Technical articles about TypeScript, NestJS, microservices, and web architecture by Ricki Friadi."
>
  <PageAnimations />

  <BlogListSkeleton />

  <div id="blog-content">
    <!-- Hero -->
    <section class="border-border border-b px-4 py-8">
      <p class="eyebrow mb-3" data-hero-reveal>Field Notes</p>
      <h1
        class="title-display"
        style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93"
        data-hero-reveal
      >
        Writing on Systems<br />
        <span class="title-accent text-accent">&amp; Craft.</span>
      </h1>
      <p class="text-muted mt-4 text-sm leading-relaxed" data-hero-reveal>
        Essays on microservices, TypeScript, architecture, and the craft of building reliable software.
      </p>
    </section>

    <!-- Post grid -->
    <section class="px-4 py-8">
      {posts.length === 0 ? (
        <p class="text-muted text-sm">No posts yet — writing in progress.</p>
      ) : (
        <BlogGrid posts={posts} />
      )}
    </section>
  </div>

  <script>
    function swapInSkeleton(contentId: string, templateId: string) {
      const content = document.getElementById(contentId)
      const template = document.getElementById(templateId)
      if (!content || !template || content.dataset.skeletonActive === 'true') return
      content.dataset.skeletonActive = 'true'
      content.style.display = 'none'
      const clone = template.cloneNode(true) as HTMLElement
      clone.removeAttribute('hidden')
      clone.id = `${templateId}-clone`
      content.insertAdjacentElement('afterend', clone)
    }

    function restoreContent(contentId: string, templateId: string) {
      const content = document.getElementById(contentId)
      const clone = document.getElementById(`${templateId}-clone`)
      if (!content) return
      content.style.display = ''
      delete content.dataset.skeletonActive
      if (clone) {
        clone.style.transition = 'opacity 200ms ease'
        clone.style.opacity = '0'
        setTimeout(() => clone.remove(), 200)
      }
    }

    document.addEventListener('astro:after-swap', () => {
      if (location.pathname.replace(/\/$/, '') === '/blog') {
        swapInSkeleton('blog-content', 'blog-skeleton-template')
      }
    })

    document.addEventListener('astro:page-load', () => {
      requestAnimationFrame(() => restoreContent('blog-content', 'blog-skeleton-template'))
    })
  </script>
</MainLayout>
