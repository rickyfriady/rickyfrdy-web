---
import type { LanguageStat } from '@/models'

interface Props {
  languages: LanguageStat[]
}

const { languages } = Astro.props
---

{languages.length > 0 && (
  <div class="rounded-xl border border-border bg-secondary/30 p-4 md:p-6" data-lang-chart>
    <p class="text-foreground mb-3 text-sm font-semibold">Most Used Languages</p>

    <!-- Stacked bar: bars start at 0 width, script animates them in -->
    <div class="flex h-[4px] md:h-4 w-full overflow-hidden rounded-full bg-secondary" aria-hidden="true">
      {languages.map((lang) => (
        <div
          class="relative h-full first:rounded-l-full last:rounded-r-full"
          style={`background: ${lang.color}; width: 0%`}
          data-lang-bar={lang.percentage}
          role="img"
          aria-label={`${lang.name}: ${lang.percentage}%`}
          title={`${lang.name}: ${lang.percentage}%`}
        />
      ))}
    </div>

    <!-- Legend: starts hidden, fades in -->
    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-2" aria-label="Language breakdown">
      {languages.map((lang) => (
        <li class="flex items-center gap-2 flex-shrink-0 opacity-0" data-lang-legend>
          <span
            class="block h-2 w-2 flex-shrink-0 rounded-full"
            style={`background: ${lang.color}`}
            aria-hidden="true"
          />
          <span class="text-foreground font-mono text-[9px] leading-none sm:text-[10px]">{lang.name}</span>
          <span class="text-muted font-mono text-[9px] leading-none sm:text-[10px]">{lang.percentage}%</span>
        </li>
      ))}
    </ul>
  </div>
)}

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  function initLangChart() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    document.querySelectorAll<HTMLElement>('[data-lang-chart]').forEach((chart) => {
      const bars = chart.querySelectorAll<HTMLElement>('[data-lang-bar]')
      const legends = chart.querySelectorAll<HTMLElement>('[data-lang-legend]')

      ScrollTrigger.create({
        trigger: chart,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          bars.forEach((bar, i) => {
            const target = bar.dataset.langBar ?? '0'
            gsap.to(bar, {
              width: `${target}%`,
              duration: reduced ? 0 : 0.7,
              delay: reduced ? 0 : i * 0.07,
              ease: 'power2.out'
            })
          })
          gsap.to(legends, {
            opacity: 1,
            y: 0,
            duration: reduced ? 0 : 0.3,
            stagger: reduced ? 0 : 0.045,
            delay: reduced ? 0 : 0.55,
            ease: 'easeOut'
          })
          gsap.set(legends, { y: 5 })
        }
      })
    })
  }

  initLangChart()
  document.addEventListener('astro:page-load', initLangChart)
</script>
