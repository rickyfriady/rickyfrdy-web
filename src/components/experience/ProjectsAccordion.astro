---
import type { ExperienceProject } from '@/models'
import { getLogoSvg } from '@/utils/finlogo'
import { getSkillIconUrl } from '@/utils/skillIcon'

interface Props {
  projects: ExperienceProject[]
}

const { projects } = Astro.props
---

<div class="space-y-2 py-6">
  {projects.map((proj) => {
    const svg = proj.companyLogo ? getLogoSvg(proj.companyLogo) : null
    return (
      <details class="group rounded-xl border border-transparent transition-colors duration-200 hover:border-border/60 open:border-border open:bg-secondary/40 open:shadow-xs" data-accordion>
        <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded-xl sm:px-5 sm:py-4">
          <div class="flex min-w-0 items-center gap-3 sm:gap-4">
            <!-- Logo -->
            {svg ? (
              <span class="inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-white p-1 sm:h-10 sm:w-10 sm:p-1.5">
                <img
                  src={`data:image/svg+xml,${encodeURIComponent(svg)}`}
                  alt={proj.company}
                  width={40}
                  height={40}
                  class="h-full w-full object-contain"
                />
              </span>
            ) : (
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border bg-secondary sm:h-10 sm:w-10">
                <span class="font-display text-base font-bold leading-none text-accent">
                  {proj.company.charAt(0)}
                </span>
              </span>
            )}

            <div class="min-w-0">
              <span class="text-foreground block truncate text-[15px] font-semibold leading-snug sm:text-base">
                {proj.title}
              </span>
              <div class="text-muted mt-0.5 flex items-center gap-1.5 truncate font-mono text-xs leading-tight sm:text-[13px]">
                <span>{proj.company}</span>
                <span class="text-border/40">·</span>
                <span class="text-muted/60 truncate">{proj.period}</span>
              </div>
            </div>
          </div>

          <!-- Chevron — rotates via CSS when details[open] -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5 shrink-0 text-muted/30 transition-transform duration-300 group-open:rotate-180 sm:h-6 sm:w-6"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>

        <!-- Expandable body -->
        <div class="accordion-body overflow-hidden" style="height: 0; opacity: 0">
          <div class="border-t border-border/40 px-4 pb-5 pt-4 sm:px-5 sm:pb-6 sm:pt-4">
            <!-- Bullets -->
            <ul class="text-muted space-y-2.5 text-sm leading-relaxed sm:text-[15px]">
              {proj.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span class="text-muted/40 mt-1.5 shrink-0 font-mono text-sm leading-none sm:mt-2">▸</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>

            <!-- Stack chips -->
            <div class="mt-4 flex flex-wrap gap-2 sm:mt-5">
              {proj.stack.map((tech) => {
                const url = getSkillIconUrl(tech)
                return (
                  <span
                    class={url
                      ? 'inline-flex items-center gap-1.5 rounded-lg border border-border/40 bg-secondary/30 px-2.5 py-1 font-mono text-xs text-muted sm:gap-2 sm:px-3 sm:py-1.5 sm:text-[13px]'
                      : 'diff-tag'}
                  >
                    {url && (
                      <img
                        src={url}
                        alt={tech}
                        title={tech}
                        width="18"
                        height="18"
                        class="rounded-sm sm:h-5 sm:w-5"
                        loading="lazy"
                      />
                    )}
                    {tech}
                  </span>
                )
              })}
            </div>
          </div>
        </div>
      </details>
    )
  })}
</div>

<script>
  import gsap from 'gsap'

  function initAccordion() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    document.querySelectorAll<HTMLDetailsElement>('details[data-accordion]').forEach((detail) => {
      if (detail.dataset.accordionInit) return
      detail.dataset.accordionInit = '1'

      const summary = detail.querySelector('summary')!
      const body = detail.querySelector<HTMLElement>('.accordion-body')!

      summary.addEventListener('click', (e) => {
        e.preventDefault()

        if (detail.open) {
          // Close: animate then remove open attr
          gsap.to(body, {
            height: 0,
            opacity: 0,
            duration: reduced ? 0 : 0.2,
            ease: 'power2.in',
            onComplete: () => detail.removeAttribute('open')
          })
        } else {
          // Close any other open accordion in the same parent
          const siblings = detail.parentElement?.querySelectorAll<HTMLDetailsElement>('details[data-accordion][open]')
          siblings?.forEach((sibling) => {
            if (sibling === detail) return
            const sibBody = sibling.querySelector<HTMLElement>('.accordion-body')!
            gsap.to(sibBody, {
              height: 0,
              opacity: 0,
              duration: reduced ? 0 : 0.2,
              ease: 'power2.in',
              onComplete: () => sibling.removeAttribute('open')
            })
          })

          detail.setAttribute('open', '')
          gsap.fromTo(body,
            { height: 0, opacity: 0 },
            { height: 'auto', opacity: 1, duration: reduced ? 0 : 0.25, ease: 'power2.out' }
          )
        }
      })
    })
  }

  initAccordion()
  document.addEventListener('astro:page-load', initAccordion)
</script>
