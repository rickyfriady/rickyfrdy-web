---
import { collaborators } from '@/data/collaborators'
import type { Collaborator } from '@/models'

interface Props {
  sectionLabel: string
  showMoreLabel?: string
}

const { sectionLabel, showMoreLabel = 'Show more' } = Astro.props

const featured = collaborators.filter((c) => c.featured)
const rest = collaborators.filter((c) => !c.featured)

function initials(name: string): string {
  return name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase()
}

function primaryHref(c: Collaborator): string {
  return c.linkedin ?? c.website ?? '#'
}
---

{collaborators.length > 0 && (
  <section class="border-border border-b" data-collab-section>
    <div class="chapter-heading px-4">
      <span class="chapter-label">{sectionLabel}</span>
    </div>

    <div class="px-4 pb-12 space-y-8">

      <!-- ── Featured collaborators: full photo cards, company on hover ──── -->
      {featured.length > 0 && (
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((c) => (
            <a
              href={primaryHref(c)}
              target="_blank"
              rel="noopener noreferrer"
              class="glass-card group relative flex flex-col overflow-hidden no-underline transition-[box-shadow,border-color] duration-500 hover:border-accent/40 hover:shadow-[0_16px_36px_color-mix(in_oklch,var(--color-accent)_14%,transparent)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              data-collab-card
            >
              <!-- Photo -->
              <div class="relative aspect-square overflow-hidden bg-secondary">
                <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <span class="font-display text-accent text-3xl font-bold leading-none">
                    {initials(c.name)}
                  </span>
                </div>
                {c.photo && (
                  <img
                    src={c.photo}
                    alt={c.name}
                    loading="lazy"
                    class="absolute inset-0 h-full w-full object-cover object-center text-transparent grayscale"
                    data-collab-photo
                  />
                )}

                <!-- Company tag: slides in from the right edge on hover (GSAP-driven) -->
                <span
                  class="border-border/60 bg-background/90 text-foreground absolute top-4 right-0 translate-x-full whitespace-nowrap rounded-l-full border border-r-0 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.1em] opacity-0 shadow-lg backdrop-blur"
                  aria-hidden="true"
                  data-collab-tag
                >
                  {c.company}
                </span>
              </div>

              <!-- Caption: name, role, company -->
              <div class="flex flex-col gap-1 p-4">
                <p class="text-foreground text-sm font-semibold leading-tight transition-colors duration-500 group-hover:text-accent">
                  {c.name}
                </p>
                <p class="text-muted font-mono text-[10px] uppercase tracking-[0.1em] leading-snug">
                  {c.role}
                </p>
                <p class="text-muted/70 font-mono text-[10px] uppercase tracking-[0.08em] leading-snug">
                  {c.company}
                </p>
              </div>
            </a>
          ))}
        </div>
      )}

      <!-- ── Show more toggle + revealed list ────────────────────── -->
      {rest.length > 0 && (
        <div class="pt-2">
          <button
            type="button"
            data-collab-toggle
            aria-expanded="false"
            aria-controls="collab-rest-list"
            class="text-muted hover:text-accent inline-flex min-h-[44px] items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] transition-colors"
          >
            <span data-collab-toggle-label>+ {rest.length} {showMoreLabel}</span>
            <span data-collab-toggle-icon class="inline-block transition-transform duration-300">↓</span>
          </button>

          <div
            id="collab-rest-list"
            data-collab-rest
            class="grid overflow-hidden"
            style="grid-template-rows: 0fr; transition: grid-template-rows 0.5s var(--ease-out-quart, ease)"
          >
            <div class="min-h-0">
              <ul class="grid gap-x-8 gap-y-3 pt-6 sm:grid-cols-2">
                {rest.map((p) => (
                  <li data-collab-rest-row>
                    <a
                      href={primaryHref(p)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex min-h-[44px] items-center gap-3 border-b border-border/40 py-2 no-underline"
                    >
                      <div class="relative size-8 flex-shrink-0 overflow-hidden rounded-full border border-border bg-secondary">
                        <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                          <span class="text-accent font-mono text-[10px] font-bold leading-none">
                            {initials(p.name)}
                          </span>
                        </div>
                        {p.photo && (
                          <img
                            src={p.photo}
                            alt={p.name}
                            loading="lazy"
                            class="absolute inset-0 h-full w-full object-cover object-center text-transparent grayscale transition-[filter] duration-300 group-hover:grayscale-0"
                          />
                        )}
                      </div>
                      <div class="min-w-0 flex-1">
                        <p class="text-foreground text-sm font-medium truncate leading-tight group-hover:text-accent transition-colors">
                          {p.name}
                        </p>
                        <p class="text-muted truncate font-mono text-[10px] uppercase tracking-[0.08em] mt-0.5">
                          {p.role} · {p.company}
                        </p>
                      </div>
                      <span class="text-muted group-hover:text-accent font-mono text-[10px] uppercase tracking-[0.14em] transition-colors" aria-hidden="true">
                        {p.linkedin ? 'in' : 'web'} &nbsp;→
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initCollaborators() {
    const section = document.querySelector<HTMLElement>('[data-collab-section]')
    if (!section) return

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      // Featured cards: staggered scroll-reveal
      const cards = section.querySelectorAll<HTMLElement>('[data-collab-card]')
      if (cards.length) {
        gsap.from(cards, {
          opacity: 0,
          y: 28,
          duration: 0.7,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: { trigger: cards[0], start: 'top 88%' },
        })
      }

      // Featured cards: GSAP-driven hover — lift, photo color reveal + zoom, tag slide-in
      const dur = 0.5
      const ease = 'power3.out'
      const cleanups: Array<() => void> = []

      cards.forEach((card) => {
        const photo = card.querySelector<HTMLElement>('[data-collab-photo]')
        const tag = card.querySelector<HTMLElement>('[data-collab-tag]')

        const enter = () => {
          gsap.to(card, { y: -6, duration: dur, ease })
          if (photo) gsap.to(photo, { filter: 'grayscale(0%)', scale: 1.06, duration: dur, ease })
          if (tag) gsap.to(tag, { x: 0, opacity: 1, duration: dur, ease })
        }
        const leave = () => {
          gsap.to(card, { y: 0, duration: dur, ease })
          if (photo) gsap.to(photo, { filter: 'grayscale(100%)', scale: 1, duration: dur, ease })
          if (tag) gsap.to(tag, { x: '100%', opacity: 0, duration: dur, ease })
        }

        card.addEventListener('mouseenter', enter)
        card.addEventListener('mouseleave', leave)
        card.addEventListener('focus', enter)
        card.addEventListener('blur', leave)

        cleanups.push(() => {
          card.removeEventListener('mouseenter', enter)
          card.removeEventListener('mouseleave', leave)
          card.removeEventListener('focus', enter)
          card.removeEventListener('blur', leave)
          gsap.set([card, photo, tag].filter(Boolean), { clearProps: 'all' })
        })
      })

      return () => cleanups.forEach((fn) => fn())
    })

    // ── Show-more toggle (works regardless of reduced motion) ─────
    const btn = section.querySelector<HTMLButtonElement>('[data-collab-toggle]')
    const rest = section.querySelector<HTMLElement>('[data-collab-rest]')
    const icon = section.querySelector<HTMLElement>('[data-collab-toggle-icon]')
    const rows = section.querySelectorAll<HTMLElement>('[data-collab-rest-row]')

    if (btn && rest) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true'
        const next = !expanded
        btn.setAttribute('aria-expanded', String(next))
        rest.style.gridTemplateRows = next ? '1fr' : '0fr'
        if (icon) icon.style.transform = next ? 'rotate(180deg)' : 'rotate(0deg)'

        // Stagger the rows when opening
        if (next && rows.length) {
          gsap.fromTo(
            rows,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, stagger: 0.035, duration: 0.4, ease: 'power2.out' }
          )
        }
      })
    }
  }

  initCollaborators()

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill())
  })

  document.addEventListener('astro:after-swap', () => {
    if (document.querySelector('[data-collab-section]')) {
      initCollaborators()
    }
  })
</script>
