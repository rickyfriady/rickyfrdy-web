---
import Skeleton from '@/components/ui/Skeleton.astro'
---

<div id="blog-skeleton-template" hidden>
  <div>
    <!-- Hero -->
    <section class="border-border border-b px-4 py-8">
      <Skeleton width="80px" height="0.7rem" class="mb-3" />
      <Skeleton width="70%" height="3rem" class="mb-2" />
      <Skeleton width="45%" height="3rem" class="mb-4" />
      <Skeleton width="60%" height="0.9rem" />
    </section>

    <!-- Post grid -->
    <section class="px-4 py-8">
      <div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {Array.from({ length: 2 }).map(() => (
          <div class="border-border overflow-hidden rounded-2xl border">
            <Skeleton width="100%" height="180px" radius="0" />
            <div class="flex flex-col gap-3 px-5 pb-5 pt-6">
              <Skeleton width="60%" height="1.25rem" />
              <Skeleton width="90%" height="0.85rem" />
              <Skeleton width="70%" height="0.85rem" />
            </div>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {Array.from({ length: 3 }).map(() => (
          <div class="border-border overflow-hidden rounded-2xl border">
            <Skeleton width="100%" height="140px" radius="0" />
            <div class="flex flex-col gap-3 px-5 pb-5 pt-6">
              <Skeleton width="60%" height="1rem" />
              <Skeleton width="85%" height="0.8rem" />
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>
