---
import AnimatedGradient from '@/components/arcade/AnimatedGradient.astro'
import BlurhashImage from '@/components/ui/BlurhashImage.astro'
import { gradientPresetFor } from '@/utils/gradientPreset'
import { readingTime } from '@/utils/readingTime'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  featured?: boolean
}

const { post, featured = false } = Astro.props
const preset = gradientPresetFor(post.id)

---

<a
  href={`/blog/${post.id}`}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-background no-underline transition-shadow duration-300 hover:shadow-[0_16px_36px_color-mix(in_oklch,var(--color-accent)_12%,transparent)]',
  ]}
  data-stagger-item
>
  <div class:list={['relative overflow-hidden bg-secondary', featured ? 'aspect-[16/10]' : 'aspect-[4/3]']}>
    {post.data.coverImage ? (
      <BlurhashImage
        src={post.data.coverImage}
        alt=""
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500"
      />
    ) : (
      <AnimatedGradient config={{ preset, speed: 10 }} noise={{ opacity: 0.1 }} style={{ zIndex: '0' }} />
    )}
  </div>

  <div class="relative flex flex-1 flex-col px-5 pb-5 pt-6">
    <span class="diff-tag bg-background absolute -top-4 left-5">{post.data.category}</span>

    <h3
      class:list={[
        'text-foreground group-hover:text-accent mt-2 font-semibold transition-colors duration-200',
        featured ? 'text-xl' : 'text-base',
      ]}
    >
      {post.data.title}
    </h3>
    <p class="text-muted mt-2 line-clamp-2 text-sm leading-relaxed">
      {post.data.description}
    </p>

    <div class="border-border/60 text-muted mt-auto flex items-center justify-between gap-2 border-t pt-4 font-mono text-xs">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="group-hover:text-accent flex items-center gap-2 transition-colors duration-200">
        {readingTime(post.body ?? '')}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </span>
    </div>
  </div>
</a>
