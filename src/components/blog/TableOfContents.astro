---
interface Props {
  headings: { depth: number; slug: string; text: string }[]
}

const { headings } = Astro.props
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{filtered.length > 0 && (
  <div>
    <p class="font-mono text-muted mb-3 text-xs uppercase tracking-[0.15em]">Contents</p>
    <nav aria-label="Table of contents">
      <ol class="space-y-2">
        {filtered.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              class:list={[
                'text-muted hover:text-accent block text-sm leading-snug transition-colors',
                { 'pl-4': heading.depth === 3 },
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
)}
