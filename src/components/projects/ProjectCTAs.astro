---
interface Props {
  liveUrl?: string
  githubUrl?: string
  liveLabel: string
  githubLabel: string
}

const { liveUrl, githubUrl, liveLabel, githubLabel } = Astro.props
---

{(liveUrl || githubUrl) && (
  <div class="flex flex-wrap gap-3">
    {liveUrl && (
      <a
        href={liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-background inline-flex min-h-10 py-2 items-center rounded-lg px-5 font-mono text-xs font-medium tracking-[0.1em] uppercase transition-all duration-200"
      >
        {liveLabel} ↗
      </a>
    )}
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border text-foreground hover:bg-secondary inline-flex min-h-10 py-2 items-center rounded-lg border px-5 font-mono text-xs font-medium tracking-[0.1em] uppercase transition-all duration-200"
      >
        {githubLabel} ↗
      </a>
    )}
  </div>
)}
