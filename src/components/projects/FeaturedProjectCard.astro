---
import type { Project } from '@/models'
import FinLogo from '@/components/ui/FinLogo.astro'
import FeaturedBadge from '@/components/ui/FeaturedBadge.astro'
import BlurhashImage from '@/components/ui/BlurhashImage.astro'

interface Props {
  project: Project
  categoryLabel?: string
  featuredLabel?: string
  locale?: string
  /** The page's locale; the card shows that locale's copy where the project records it. */
  lang?: 'en' | 'id'
}

const { project, categoryLabel, featuredLabel = 'Featured', locale = 'en-US', lang = 'en' } = Astro.props
const copy = (lang !== 'en' && project.translations?.[lang]) || project
const catLabel = categoryLabel ?? project.category.replace('-', ' ')
const dateStr = new Date(project.date).toLocaleDateString(locale, { month: 'short', year: 'numeric' })

const stat1 = copy.metrics?.[0]
const stat2 = copy.metrics?.[1]
---

<div class:list={["relative", project.featured ? "pixel-frame" : ""]}>
<a
  href={`/projects/${project.slug}`}
  aria-labelledby={`card-title-${project.slug}`}
  class:list={[
    "group relative flex flex-col overflow-hidden no-underline min-h-[220px] transition-all duration-300",
    project.featured
      ? "z-10"
      : "border border-border hover:border-accent/60"
  ]}
  style="background: var(--color-surface);"
>
  <!-- ── Image strip: above the text, so no text ever sits on it ── -->
  {project.heroImage && (
    <div class="border-border pointer-events-none h-32 overflow-hidden border-b">
      <BlurhashImage
        src={project.heroImage}
        alt=""
        class="h-full w-full object-cover object-left-top
               grayscale transition-[transform,filter] duration-700 ease-out will-change-transform
               group-hover:grayscale-0"
      />
    </div>
  )}

  <!-- ── Card content ───────────────────────────────────────────── -->
  <div class="relative z-10 flex flex-1 flex-col p-5">
    <!-- Top row: badges (left), date pill and logo side by side (right) -->
    <div class="mb-3 flex items-start justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        {project.featured && <FeaturedBadge label={featuredLabel} />}
        <span class="diff-tag">{catLabel}</span>
      </div>
      <div class="flex flex-shrink-0 items-center gap-2">
        <span
          class="rounded-full border px-2 py-1 font-mono text-label leading-tight
                 border-accent/50 text-accent"
        >
          {dateStr}
        </span>
        {project.companyLogo && (
          <FinLogo name={project.companyLogo} size={32} bg label={project.company} />
        )}
      </div>
    </div>

    <div>
      <h3
        id={`card-title-${project.slug}`}
        class="text-foreground group-hover:text-accent text-base font-semibold leading-snug transition-colors duration-300"
        transition:name={`project-title-${project.slug}`}
      >
        {project.title}
      </h3>

      <p class="text-muted mt-2 text-sm leading-relaxed">
        {copy.shortDescription}
      </p>
    </div>

    <!-- Spacer pushes stats to bottom -->
    <div class="flex-1" />

    <!-- Divider + stats row: values read as primary text, labels stay quiet -->
    <div class="border-border relative -mx-5 -mb-5 mt-4 border-t bg-background px-5 pt-3 pb-5">
      <div class="text-muted flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
        {stat1 && (
          <span class="flex items-center gap-2">
            <span class="text-foreground text-sm font-semibold">{stat1.value}</span>
            <span>{stat1.label}</span>
          </span>
        )}
        {stat2 && (
          <span class="flex items-center gap-2">
            <span class="text-foreground text-sm font-semibold">{stat2.value}</span>
            <span>{stat2.label}</span>
          </span>
        )}
      </div>
    </div>
  </div>
</a>
</div>
