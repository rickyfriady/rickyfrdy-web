---
import type { Project } from '@/models'
import BlurhashImage from '@/components/ui/BlurhashImage.astro'

interface Props {
  project: Project
  categoryLabel?: string
  locale?: string
  /** The page's locale; the card shows that locale's copy where the project records it. */
  lang?: 'en' | 'id'
}

const { project, categoryLabel, locale = 'en-US', lang = 'en' } = Astro.props
const copy = (lang !== 'en' && project.translations?.[lang]) || project
const catLabel = categoryLabel ?? project.category.replace('-', ' ')
const dateStr = new Date(project.date).toLocaleDateString(locale, { month: 'short', year: 'numeric' })

const stat1 = copy.metrics?.[0]
const stat2 = copy.metrics?.[1]
---

<!-- Every landing card is an equal: "Selected Work" is already the selection. -->
<div class="pixel-frame relative h-full">
<a
  href={`/projects/${project.slug}`}
  aria-labelledby={`card-title-${project.slug}`}
  class="group relative z-10 flex h-full min-h-[220px] flex-col overflow-hidden no-underline transition-colors duration-300"
  style="background: var(--color-surface);"
>
  <!-- ── Image strip: above the text, so no text ever sits on it ── -->
  {project.heroImage && (
    <div class="border-border pointer-events-none h-24 overflow-hidden border-b sm:h-32">
      <BlurhashImage
        src={project.heroImage}
        alt=""
        position={project.heroFocus}
        srcset={`${project.heroImage.replace(/\.webp$/, '-720.webp')} 720w, ${project.heroImage} 1440w`}
        sizes="(min-width: 768px) 360px, calc(100vw - 32px)"
        class="h-full w-full object-cover object-center"
      />
    </div>
  )}

  <!-- ── Card content ───────────────────────────────────────────── -->
  <div class="relative z-10 flex flex-1 flex-col p-5">
    <!-- Head: category and date only; the hero already names the employer -->
    <div class="mb-3 flex items-center justify-between gap-2">
      <span class="diff-tag">{catLabel}</span>
      <span class="border-accent/50 text-accent border px-2 py-1 font-mono text-label leading-tight">
        {dateStr}
      </span>
    </div>

    <div>
      <h3
        id={`card-title-${project.slug}`}
        class="text-foreground group-hover:text-accent text-base font-semibold leading-snug transition-colors duration-300"
        transition:name={`project-title-${project.slug}`}
      >
        {project.title}
      </h3>

      <p class="text-muted mt-2 text-sm leading-relaxed">
        {copy.shortDescription}
      </p>
    </div>

    <!-- Spacer pushes stats to bottom -->
    <div class="flex-1" />

    <!-- Divider + stats row: the evidence, at the description's size; values in mono -->
    <div class="border-border relative -mx-5 -mb-5 mt-4 border-t bg-background px-5 pt-3 pb-5">
      <div class="text-muted flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
        {stat1 && (
          <span class="flex items-center gap-2">
            <span class="text-foreground whitespace-nowrap font-mono font-semibold">{stat1.value}</span>
            <span>{stat1.label}</span>
          </span>
        )}
        {stat2 && (
          <span class="flex items-center gap-2">
            <span class="text-foreground whitespace-nowrap font-mono font-semibold">{stat2.value}</span>
            <span>{stat2.label}</span>
          </span>
        )}
      </div>
    </div>
  </div>
</a>
</div>
