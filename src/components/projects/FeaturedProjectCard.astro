---
import type { Project } from '@/data/projects'
import FinLogo from '@/components/ui/FinLogo.astro'
import FeaturedBadge from '@/components/ui/FeaturedBadge'

interface Props {
  project: Project
  categoryLabel?: string
  featuredLabel?: string
  locale?: string
}

const { project, categoryLabel, featuredLabel = 'Featured', locale = 'en-US' } = Astro.props
const catLabel = categoryLabel ?? project.category.replace('-', ' ')
const dateStr = new Date(project.date).toLocaleDateString(locale, { month: 'short', year: 'numeric' })

const stat1 = project.metrics?.[0]
const stat2 = project.metrics?.[1]
---

<a
  href={`/projects/${project.slug}`}
  class="group relative flex flex-col overflow-hidden rounded-xl no-underline min-h-[220px]
         border border-border transition-all duration-300
         hover:border-accent/60 hover:shadow-[0_0_28px_color-mix(in_oklch,var(--color-accent)_12%,transparent)]"
  style="background: color-mix(in oklch, var(--color-background) 72%, transparent); backdrop-filter: blur(14px);"
>
  <!-- ── Bottom-right corner image ─────────────────────────────── -->
  {project.heroImage && (
    <div
      class="pointer-events-none absolute right-0 bottom-0 w-[52%] h-[75%] overflow-hidden"
      style="-webkit-mask-image: linear-gradient(118deg, transparent 10%, rgba(0,0,0,0.6) 38%, black 58%); mask-image: linear-gradient(118deg, transparent 10%, rgba(0,0,0,0.6) 38%, black 58%)"
    >
      <img
        src={project.heroImage}
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover object-left-top
               grayscale transition-[transform,filter] duration-700 ease-out will-change-transform
               group-hover:scale-[1.07] group-hover:grayscale-0"
      />
      <!-- Bottom fade so stats row stays readable -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-background/80 to-transparent" />
    </div>
  )}

  <!-- ── Diagonal accent cut line ───────────────────────────────── -->
  {project.heroImage && (
    <div
      class="pointer-events-none absolute right-0 bottom-0 w-[52%] h-[75%]
             opacity-50 transition-opacity duration-300 group-hover:opacity-100"
      style="background: linear-gradient(118deg, transparent 36.5%, color-mix(in oklch, var(--color-accent) 55%, transparent) 37%, transparent 37.5%)"
    />
  )}

  <!-- ── Accent glow bloom on hover ─────────────────────────────── -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at 80% 90%, color-mix(in oklch, var(--color-accent) 13%, transparent) 0%, transparent 55%)"
  />

  <!-- ── Card content ───────────────────────────────────────────── -->
  <div class="relative z-10 flex flex-1 flex-col p-5">
    <!-- Top row: badges (left) + date pill + logo (right) -->
    <div class="mb-3 flex items-start justify-between gap-2">
      <div class="flex flex-wrap items-center gap-1.5">
        {project.featured && <FeaturedBadge client:visible label={featuredLabel} />}
        <span class="diff-tag">{catLabel}</span>
        <span class="diff-tag">{project.year}</span>
      </div>
      <div class="flex flex-shrink-0 flex-col items-end gap-2">
        <span
          class="rounded-full border px-2 py-0.5 font-mono text-[10px] leading-tight
                 border-accent/50 text-accent"
        >
          {dateStr}
        </span>
        {project.companyLogo && (
          <FinLogo name={project.companyLogo} size={32} bg label={project.company} />
        )}
      </div>
    </div>

    <!-- Title -->
    <h2
      class="text-foreground group-hover:text-accent text-base font-semibold leading-snug transition-colors duration-300 max-w-[58%]
             group-hover:[text-shadow:0_0_20px_color-mix(in_oklch,var(--color-accent)_40%,transparent)]"
      transition:name={`project-title-${project.slug}`}
    >
      {project.title}
    </h2>

    <!-- Description -->
    <p class="text-muted mt-2 line-clamp-2 text-sm leading-relaxed max-w-[60%]">
      {project.shortDescription}
    </p>

    <!-- Spacer pushes stats to bottom -->
    <div class="flex-1" />

    <!-- Divider + stats row -->
    <div class="border-border mt-4 border-t pt-3">
      <div class="text-muted flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
        {stat1 && (
          <span class="flex items-center gap-1.5">
            <svg class="h-3 w-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span class="text-foreground font-medium">{stat1.value}</span>
            <span>{stat1.label}</span>
          </span>
        )}
        {stat1 && stat2 && <span class="text-border select-none">·</span>}
        {stat2 && (
          <span class="flex items-center gap-1.5">
            <svg class="h-3 w-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span class="text-foreground font-medium">{stat2.value}</span>
            <span>{stat2.label}</span>
          </span>
        )}
      </div>
    </div>
  </div>
</a>
