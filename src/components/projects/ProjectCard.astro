---
import type { Project } from '@/models'
import FinLogo from '@/components/ui/FinLogo.astro'

interface Props {
  project: Project
  categoryLabel?: string
  featuredLabel?: string
}

const { project, categoryLabel, featuredLabel = 'Featured' } = Astro.props
const catLabel = categoryLabel ?? project.category.replace('-', ' ')
---

<div
  data-card
  data-category={project.category}
  class:list={["relative", project.featured ? "pixel-frame pixel-frame-thread" : ""]}
>
<a
  href={`/projects/${project.slug}`}
  class:list={[
    "group relative flex items-center gap-4 overflow-hidden no-underline transition-colors duration-200 evidence-card px-5 py-4",
    project.featured ? " z-10" : "rounded-xl hover:border-accent/50"
  ]}
>
  <!-- Left accent bar: reveals on hover -->
  <div class="absolute inset-y-0 left-0 w-1 bg-accent origin-bottom scale-y-0 transition-transform duration-300 group-hover:scale-y-100" />

  <!-- Right geometric decoration -->
  <div class="pointer-events-none absolute inset-y-0 right-0 w-44 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-l from-secondary/90 via-secondary/40 to-transparent" />
    <div
      class="absolute inset-0 opacity-40"
      style="background: linear-gradient(135deg, transparent 55%, color-mix(in oklch, var(--color-border) 60%, transparent) 55%)"
    />
  </div>

  <!-- Content -->
  <div class="relative z-10 min-w-0 flex-1">
    <!-- Badge row -->
    <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1">
      {project.company && (
        <span class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase">{project.company}</span>
      )}
      {project.company && <span class="text-border select-none text-[10px]">·</span>}
      <span class="diff-tag">{catLabel}</span>
      <span class="diff-tag">{project.year}</span>
      {project.featured && <span class="eyebrow">{featuredLabel}</span>}
    </div>

    <!-- Title -->
    <h2 class="text-foreground group-hover:text-accent truncate text-base font-semibold leading-snug transition-colors duration-200">
      {project.title}
    </h2>

    <!-- Role subtitle -->
    {project.role && (
      <p class="text-muted mt-1 truncate font-mono text-xs">{project.role}</p>
    )}

    <!-- Bottom: key metric + tech chips -->
    <div class="mt-2 flex flex-wrap items-center gap-2">
      {project.keyMetric && (
        <>
          <span class="text-accent font-mono text-[10px]">{project.keyMetric}</span>
          {project.technologies.length > 0 && <span class="text-border select-none text-[10px]">·</span>}
        </>
      )}
      {project.technologies.slice(0, 3).map((tech) => (
        <span class="bg-secondary text-muted rounded px-2 py-1 font-mono text-[10px]">{tech}</span>
      ))}
      {project.technologies.length > 3 && (
        <span class="text-muted font-mono text-[10px]">+{project.technologies.length - 3}</span>
      )}
    </div>
  </div>

  <!-- Logo -->
  <div class="relative z-10 flex-shrink-0">
    {project.companyLogo ? (
      <FinLogo name={project.companyLogo} size={40} bg label={project.company} />
    ) : (
      <div class="h-10 w-10 rounded-full border border-border bg-secondary flex items-center justify-center">
        <span class="text-muted font-mono text-xs uppercase">
          {(project.company ?? project.title).charAt(0)}
        </span>
      </div>
    )}
  </div>
</a>
</div>
