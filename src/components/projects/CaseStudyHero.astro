---
import type { Project } from '@/models'
import FinLogo from '@/components/ui/FinLogo.astro'
import MetricCounters from '@/components/projects/MetricCounters.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<!-- Sized to its content, on the page ground: the reader came from a card's
     numbers, so the numbers are on the first screen and the photo follows. -->
<header class="px-6 pt-10 pb-12 md:px-16" data-hero>
  <div id="case-study-hero-title">
    {project.companyLogo && (
      <div class="mb-6" data-hero-item>
        <FinLogo name={project.companyLogo} size={28} bg label={project.company} />
      </div>
    )}

    <p
      class="font-mono mb-4 text-[11px] tracking-[0.25em] uppercase text-foreground"
      data-hero-item
    >
      {project.category.replace(/-/g, ' ')} &nbsp;·&nbsp; {project.year}
    </p>

    <!-- Title — clip-path reveal from overflow:hidden parent -->
    <div class="overflow-hidden mb-6">
      <h1
        class="title-display text-foreground"
        style="font-size: clamp(2.5rem, 7vw, 5rem); line-height: 0.9; will-change: transform;"
        transition:name={`project-title-${project.slug}`}
        data-hero-title
      >
        {project.title}
      </h1>
    </div>

    <p class="max-w-xl text-sm leading-relaxed text-foreground" data-hero-item>
      {project.shortDescription}
    </p>
  </div>

  {project.metrics && project.metrics.length > 0 && (
    <div class="mt-8 max-w-3xl">
      <MetricCounters metrics={project.metrics} />
    </div>
  )}

  {project.heroImage ? (
    <figure class="pixel-frame mt-10 aspect-[16/7] max-w-5xl overflow-hidden">
      <img src={project.heroImage} alt="" aria-hidden="true" class="h-full w-full object-cover" />
    </figure>
  ) : null}
</header>
