---
import WrapShader from './WrapShader.astro'

interface Props {
  eyebrow?: string
  headingLine1?: string
  headingLine2?: string
  subtitle?: string
}

const {
  eyebrow = 'Contact',
  headingLine1 = "Let's Build",
  headingLine2 = 'Something Together.',
  subtitle = "Open to fullstack roles, freelance projects, and interesting collaborations. Drop a message and I'll get back to you within a few days."
} = Astro.props
---

<section class="relative overflow-hidden border-b border-border">
  <WrapShader />

  <!-- Gradient overlay for text contrast -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-background/40 to-background/90" />

  <div class="relative z-10 px-4 py-10 pb-12">
    <p class="eyebrow mb-3" data-hero-reveal>{eyebrow}</p>

    <h1
      class="title-display"
      style="font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.93"
      data-hero-reveal
    >
      {headingLine1}
      <br />
      <span class="title-accent text-accent">{headingLine2}</span>
    </h1>

    <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted" data-hero-reveal>
      {subtitle}
    </p>

    <!-- Available status badge -->
    <div class="mt-6" data-hero-reveal>
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-background/70 px-3 py-1.5 font-mono text-[11px] uppercase tracking-widest text-muted backdrop-blur-sm">
        <span class="t-badge-dot inline-block h-2 w-2 flex-shrink-0 rounded-full bg-emerald-500" />
        Available
      </span>
    </div>

    <!-- CTA buttons -->
    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-hero-reveal>
      <a
        href="mailto:friadi.ricki@gmail.com"
        class="glass-btn inline-flex items-center gap-2.5 border border-border px-4 py-3 text-sm text-foreground"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 flex-shrink-0 text-accent" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span>friadi.ricki@gmail.com</span>
      </a>

      <a
        href="https://www.linkedin.com/in/rickifriadi"
        target="_blank"
        rel="noopener noreferrer"
        class="glass-btn inline-flex items-center gap-2.5 border border-border px-4 py-3 text-sm text-foreground"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 flex-shrink-0 text-accent" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
        <span>linkedin.com/in/rickifriadi</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto h-3 w-3 flex-shrink-0 text-muted/50" aria-hidden="true">
          <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        </svg>
      </a>
    </div>
  </div>
</section>
