---
import ContactForm from './ContactForm.astro'

interface Props {
  sectionLabel?: string
}

const { sectionLabel = 'CASE 01 · Send a Message' } = Astro.props
---

<div data-stagger-item>
  <div class="chapter-heading px-4">
    <span class="chapter-label">{sectionLabel}</span>
  </div>
  <div class="px-4 pb-10">
    <div class="max-w-lg">
      <ContactForm />
    </div>
  </div>
</div>
