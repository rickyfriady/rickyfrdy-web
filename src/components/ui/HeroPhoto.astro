---
import { t } from '@/i18n/ui'

interface Props {
  lang?: 'en' | 'id'
}

const { lang = 'en' } = Astro.props
---

<!-- Below md a thumbnail row above the eyebrow, so the pill clears the bottom nav; from md the portrait card. -->
<div
  class="order-first flex flex-shrink-0 items-center gap-4 self-start md:order-none md:flex-col md:items-start md:gap-0 md:self-center"
  data-hero-reveal
>
  <!-- Portrait photo card, static gradient border; one image, sized by class -->
  <div
    class="relative w-[72px] aspect-[3/4] flex-shrink-0 p-[3px] md:w-[clamp(148px,20vw,196px)] md:p-[4px]"
    style="background: linear-gradient(145deg, color-mix(in oklch, var(--color-accent) 55%, transparent), color-mix(in oklch, var(--color-accent) 18%, var(--color-border)))"
    data-parallax-wrap
  >
    <div
      class="relative h-full w-full overflow-hidden transition-transform duration-300 ease-out"
      style="background: color-mix(in oklch, var(--color-background) 96%, transparent)"
      data-parallax-target
    >
      <img
        src="/images/avatar.jpg"
        alt="Ricki Friadi"
        width={196}
        height={261}
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover object-top text-transparent"
      />
    </div>
  </div>

  <!-- Availability pill -->
  <div class="flex justify-start md:mt-4" data-hero-reveal>
    <div
      class="inline-flex items-center gap-2 rounded-full border px-4 py-2"
      style="border-color: color-mix(in oklch, var(--color-accent) 22%, transparent); background: color-mix(in oklch, var(--color-accent) 7%, transparent)"
    >
      <!-- A still status mark: a looping ping was eased motion that never rests. -->
      <span class="inline-flex size-[8px] flex-shrink-0 bg-accent" aria-hidden="true" />
      <span class="text-muted font-mono text-[11px] tracking-[0.08em]">{t(lang, 'hero.available')}</span>
    </div>
  </div>
</div>
