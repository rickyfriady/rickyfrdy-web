---
/**
 * "Featured", as a label. It used to loop a Lottie fire, which was smooth
 * motion against the site's `steps()` rule and a whole animation library on the
 * pages a recruiter reads; the word already says it.
 */
interface Props {
  label: string
}

const { label } = Astro.props
---

<span class="eyebrow">{label}</span>
