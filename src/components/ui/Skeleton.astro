---
interface Props {
  width?: string
  height?: string
  radius?: string
  class?: string
}

const { width = '100%', height = '1rem', radius = '0.375rem', class: className = '' } = Astro.props
---

<div
  class:list={['animate-pulse bg-secondary', className]}
  style={{ width, height, borderRadius: radius }}
></div>
