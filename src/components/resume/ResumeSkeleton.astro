---
import Skeleton from '@/components/ui/Skeleton.astro'
---

<div id="resume-skeleton-template" hidden>
  <div class="mx-auto max-w-2xl px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <Skeleton width="240px" height="2.25rem" class="mb-2" />
      <Skeleton width="140px" height="0.9rem" class="mb-3" />
      <div class="flex flex-wrap gap-3">
        <Skeleton width="110px" height="0.7rem" />
        <Skeleton width="160px" height="0.7rem" />
        <Skeleton width="150px" height="0.7rem" />
      </div>
    </div>

    <hr class="border-border mb-8" />

    <!-- Summary -->
    <section class="mb-8">
      <Skeleton width="80px" height="0.6rem" class="mb-3" />
      <Skeleton width="100%" height="0.85rem" class="mb-2" />
      <Skeleton width="100%" height="0.85rem" class="mb-2" />
      <Skeleton width="60%" height="0.85rem" />
    </section>

    <hr class="border-border mb-8" />

    <!-- Work Experience -->
    <section class="mb-8">
      <Skeleton width="140px" height="0.6rem" class="mb-4" />
      <div class="space-y-8">
        {Array.from({ length: 2 }).map(() => (
          <div>
            <div class="flex items-center gap-2">
              <Skeleton width="22px" height="22px" radius="9999px" />
              <Skeleton width="120px" height="1rem" />
              <Skeleton width="80px" height="1.5rem" radius="0.375rem" />
            </div>
            <Skeleton width="160px" height="0.7rem" class="mt-2" />
            <div class="mt-3 space-y-2">
              <Skeleton width="95%" height="0.85rem" />
              <Skeleton width="90%" height="0.85rem" />
              <Skeleton width="70%" height="0.85rem" />
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {Array.from({ length: 4 }).map(() => (
                <Skeleton width="60px" height="1.5rem" radius="0.375rem" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Education -->
    <section class="mb-8">
      <Skeleton width="90px" height="0.6rem" class="mb-4" />
      <div>
        <div class="flex items-baseline gap-2">
          <Skeleton width="180px" height="1rem" />
          <Skeleton width="90px" height="1.5rem" radius="0.375rem" />
        </div>
        <Skeleton width="150px" height="0.7rem" class="mt-2" />
      </div>
    </section>

    <hr class="border-border mb-8" />

    <!-- Skills -->
    <section class="mb-12">
      <Skeleton width="60px" height="0.6rem" class="mb-4" />
      <div class="space-y-4">
        {Array.from({ length: 2 }).map(() => (
          <div>
            <Skeleton width="100px" height="0.6rem" class="mb-2" />
            <div class="flex flex-wrap gap-1.5">
              {Array.from({ length: 5 }).map(() => (
                <Skeleton width="64px" height="1.5rem" radius="0.375rem" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>
