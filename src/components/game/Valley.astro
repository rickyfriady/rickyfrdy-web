---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import CharacterShowcase from '@/components/game/CharacterShowcase.astro'
import PlayScene from '@/components/game/PlayScene'
import { collaborators } from '@/data/collaborators'
import { experiences as experiencesEn } from '@/data/experience'
import { experiences as experiencesId } from '@/data/experience.id'
import { projects } from '@/data/projects'
import { npcs, quests } from '@/data/quests'
import { villagers } from '@/data/villagers'
import { rooms } from '@/data/rooms'
import { t } from '@/i18n/ui'
import { fetchActivity } from '@/utils/github'
import { buildNpcs, buildScene, buildVillagers, sceneDestinations } from '@/utils/game/scene'
import { deriveStats } from '@/utils/game/stats'
import { weatherFrom } from '@/utils/game/time'

/**
 * The valley: the front door on `/`, and the same world on `/play`.
 *
 * The destination list comes first in the document and is plain server
 * rendered links, so a crawler, a visitor without JavaScript, and anyone on a
 * narrow screen get every destination before any tile or sprite is requested.
 * The world mounts beside it on wide screens only, and never gates anything:
 * every building's route is also in the list.
 */
interface Props {
  lang: 'en' | 'id'
  /** The character card, for `/play`, where there is room for it. */
  showcase?: boolean
  mobilePlayScene?: boolean
  /**
   * Hrefs the page already links elsewhere (its project cards and posts). The
   * list leaves those pieces out rather than repeating them; `/play` has no
   * such sections and passes nothing, so it lists every piece.
   */
  linkedElsewhere?: string[]
}

const { lang, showcase = false, mobilePlayScene = showcase, linkedElsewhere = [] } = Astro.props
const experiences = lang === 'id' ? experiencesId : experiencesEn

const posts = ((await getCollection('blog')) as CollectionEntry<'blog'>[])
  .filter((entry) => !entry.data.draft)
  .map((entry) => ({ slug: entry.id, title: entry.data.title, description: entry.data.description }))

const routes = [
  {
    path: '/about',
    title: t(lang, 'nav.about'),
    summary: t(lang, 'valley.summary.about'),
    place: t(lang, 'valley.place.home')
  },
  {
    path: '/contact',
    title: t(lang, 'nav.contact'),
    summary: t(lang, 'valley.summary.contact'),
    place: t(lang, 'valley.place.post')
  },
  {
    path: '/projects',
    title: t(lang, 'nav.projects'),
    summary: t(lang, 'valley.summary.projects'),
    place: t(lang, 'valley.place.workshop')
  },
  {
    path: '/blog',
    // The blog is English-only, like the case studies: there is no /id/blog.
    href: '/blog',
    title: t(lang, 'valley.route.blog'),
    summary: t(lang, 'valley.summary.blog'),
    place: t(lang, 'valley.place.journal')
  },
  {
    path: '/experience',
    title: t(lang, 'nav.experience'),
    summary: t(lang, 'valley.summary.experience'),
    place: t(lang, 'valley.place.records')
  },
  {
    path: '/board',
    title: t(lang, 'valley.route.board'),
    summary: t(lang, 'valley.summary.board'),
    place: t(lang, 'valley.place.board')
  }
]

const sources = { projects, posts, experiences, people: collaborators, routes }
const scene = buildScene(rooms, sources, lang)
const destinations = sceneDestinations(scene)
const places = destinations.filter((d) => d.place)
const pieces = destinations.filter((d) => !d.place && !(d.href && linkedElsewhere.includes(d.href)))
const sceneNpcs = buildNpcs(npcs, collaborators, lang)
const sceneVillagers = buildVillagers(villagers, lang)

const sceneQuests = quests.map((quest) => ({
  id: quest.id,
  npcId: quest.npcId,
  requires: quest.requires,
  title: quest.title[lang],
  passages: quest.passages.map((p) => p[lang]),
  completedBy: quest.completedBy,
  destination: quest.destination
}))

// Weather is read once per build from real activity; `null` is settled weather.
const weather = weatherFrom(await fetchActivity(import.meta.env.GITHUB_TOKEN), new Date())

const player = {
  name: 'Ricki Friadi',
  role: `${experiences[0].role} · ${experiences[0].company}`,
  stats: deriveStats(projects, experiences, new Date().getFullYear())
}

const labels = {
  sceneName: t(lang, 'game.sceneName'),
  controls: t(lang, 'game.controls'),
  ambientOn: t(lang, 'game.ambient.on'),
  ambientOff: t(lang, 'game.ambient.off'),
  ambientVolume: t(lang, 'game.ambient.volume'),
  journal: t(lang, 'game.journal'),
  sheet: t(lang, 'game.sheet'),
  interact: t(lang, 'game.interact'),
  open: t(lang, 'game.open'),
  next: t(lang, 'game.next'),
  close: t(lang, 'game.close'),
  reset: t(lang, 'game.reset'),
  resetConfirm: t(lang, 'game.resetConfirm'),
  statBasis: t(lang, 'game.statBasis'),
  state_locked: t(lang, 'game.state.locked'),
  state_available: t(lang, 'game.state.available'),
  state_active: t(lang, 'game.state.active'),
  state_complete: t(lang, 'game.state.complete'),
  dir_up: t(lang, 'game.dir.up'),
  dir_down: t(lang, 'game.dir.down'),
  dir_left: t(lang, 'game.dir.left'),
  dir_right: t(lang, 'game.dir.right')
}

const kindLabel = (kind: string) =>
  kind === 'project' || kind === 'post' || kind === 'experience'
    ? t(lang, `valley.kind.${kind}`)
    : kind
---

<!--
  `.world` is the threshold: its palette follows the visitor's clock (see the
  script straight after the opening tag), and nothing outside it changes.
-->
<section class="world world-bleed scene-backdrop border-border border-y-4 px-4 py-8" data-valley>
  <script is:inline>
    /* Before first paint, so there is no flash of the wrong season. Read from
       the clock on every load and never stored. Mirrors seasonOf and timeOfDay
       in src/utils/game/time.ts. */
    ;(() => {
      const el = document.currentScript.parentElement
      const now = new Date()
      const m = now.getMonth()
      const h = now.getHours()
      el.dataset.season = m >= 2 && m <= 4 ? 'spring' : m >= 5 && m <= 7 ? 'summer' : m >= 8 && m <= 10 ? 'autumn' : 'winter'
      el.dataset.time = h >= 6 && h < 18 ? 'day' : 'night'
    })()
  </script>

  {/* With scripts blocked the world column would hold only its fallback line, so
      the list takes the band's width. Same `noscript` pattern as the bottom nav;
      skipped with the showcase, whose character sheet renders without scripts. */}
  {!showcase && (
    <noscript><style is:inline>
      @media (min-width: 48rem) { [data-valley] [data-stage-col] { display: none } }
      @media (min-width: 64rem) {
        [data-valley] [data-list-col] { width: 100% }
        [data-valley] [data-list-col] ul { grid-template-columns: repeat(3, minmax(0, 1fr)) }
        [data-valley] [data-list-col] li.col-span-2 { grid-column: 1 / -1 }
      }
    </style></noscript>
  )}

  <div class="mx-auto flex max-w-6xl flex-col gap-8 lg:flex-row lg:items-start">
    <div class="lg:w-96 lg:shrink-0" data-list-col>
      <h2 class="chapter-label inline">{t(lang, 'case.file')}</h2>
      <p class="text-muted mt-2 text-sm leading-relaxed">{t(lang, 'valley.intro')}</p>
      {!showcase && (
        <noscript><p class="text-muted mt-2 text-sm leading-relaxed">{t(lang, 'game.loading')}</p></noscript>
      )}
      <ul class="mt-4 grid grid-cols-2 gap-2" aria-label={t(lang, 'game.destinations')}>
        {places.map((object) => (
          <li>
            <a href={object.href} class="menu-cursor portal-card no-underline">
              <span class="text-muted hidden font-mono text-label tracking-[0.12em] uppercase md:block">
                {object.place}
              </span>
              <span class="text-foreground block text-sm font-semibold leading-tight md:mt-1">
                {object.title}
              </span>
              {/* Between lg and xl the stage drops to scale 2 and its column shortens, so the
                  summaries step aside there and the world, not its index, sets the height. */}
              <span class="text-muted mt-1 hidden text-xs leading-snug md:block lg:hidden xl:block">{object.summary}</span>
            </a>
          </li>
        ))}
        {/* The individual pieces inside the buildings: one line each, so the
            list stays a list and does not outgrow the world beside it. Below
            `md` they stay in the HTML but are not shown: there is no world to
            walk there, each one is a tap away through its place, and "Selected
            Work" repeats them directly below. */}
        {pieces.map((object) => (
          <li class="col-span-2 hidden md:block">
            <a
              href={object.href}
              class="menu-cursor text-foreground hover:text-accent flex min-h-11 items-baseline gap-3 py-2 text-sm no-underline"
            >
              <span class="text-muted w-14 shrink-0 font-mono text-label tracking-[0.12em] uppercase">
                {kindLabel(object.kind)}
              </span>
              <span class="leading-snug">{object.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex min-w-0 flex-1 flex-col items-center gap-6 lg:flex-row lg:items-start lg:justify-center" data-stage-col>
      <div class={mobilePlayScene ? 'w-full flex justify-center' : 'hidden w-full md:block'}>
        <PlayScene
          client:only="react"
          rooms={scene}
          npcs={sceneNpcs}
          villagers={sceneVillagers}
          quests={sceneQuests}
          player={player}
          labels={labels}
          weather={weather}
          allowMobileHandheld={mobilePlayScene}
        >
          {/* Server-rendered, replaced when the island mounts: with scripts
              blocked the slot says where the places are, in one line, and the
              list beside it keeps the width. */}
          <p slot="fallback" class="soft-panel text-muted p-4 text-sm">
            {t(lang, 'game.loading')}
          </p>
        </PlayScene>
      </div>
      {!mobilePlayScene && (
        <p class="text-muted text-sm md:hidden">{t(lang, 'game.smallScreen')}</p>
      )}

      {showcase && (
        <CharacterShowcase
          name={player.name}
          role={player.role}
          stats={player.stats}
          labels={{ heading: t(lang, 'game.showcase'), basis: t(lang, 'game.statBasis'), level: 'Lv.' }}
        />
      )}
    </div>
  </div>
</section>
