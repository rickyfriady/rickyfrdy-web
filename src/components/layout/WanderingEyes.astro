---
interface Props {
  /** Home link, or a bare specimen for the evidence locker. */
  asLink?: boolean
  /**
   * The site-wide rule flattens `rounded-full`, so the header eyes are square
   * by default. The evidence locker opts back into the original round form via
   * an inline radius, which outranks the utility.
   */
  round?: boolean
}

const { asLink = true, round = false } = Astro.props
const Tag = asLink ? 'a' : 'div'
const eyeStyle = round ? 'border-radius: 9999px' : ''
---
<Tag
  href={asLink ? '/' : undefined}
  class="text-foreground font-display inline-flex items-center gap-2 text-lg font-light tracking-tight rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
>
  <span aria-hidden="true" class="inline-flex gap-1" id="wandering-eyes-container">
    <div class="we-eye border-border relative h-4 w-4 overflow-hidden border-2" style={eyeStyle}>
      <div class="we-inner absolute inset-0">
        <div class="bg-accent absolute top-[4px] left-1/2 h-[4px] w-[4px] -translate-x-1/2" style={eyeStyle}></div>
      </div>
    </div>
    <div class="we-eye border-border relative h-4 w-4 overflow-hidden border-2" style={eyeStyle}>
      <div class="we-inner absolute inset-0">
        <div class="bg-accent absolute top-[4px] left-1/2 h-[4px] w-[4px] -translate-x-1/2" style={eyeStyle}></div>
      </div>
    </div>
  </span>
  {asLink ? <span class="whitespace-nowrap">Ricki Friadi</span> : null}
</Tag>

<script>
  import { animate } from 'motion'

  function initWanderingEyes() {
    const container = document.getElementById('wandering-eyes-container')
    if (!container || container.dataset.weInit) return
    container.dataset.weInit = '1'

    const isPointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches

    if (!isPointer) {
      for (const eye of Array.from(container.querySelectorAll<HTMLElement>('.we-eye'))) {
        const span = document.createElement('span')
        span.style.cssText = [
          'display:inline-block',
          'border-radius:9999px',
          'width:16px',
          'height:16px',
          'background-color:color-mix(in srgb,currentColor 16%,transparent)',
          'background-image:radial-gradient(circle 5px,currentColor 100%,transparent 0)',
          'background-repeat:no-repeat',
          'background-position:0 0',
          'animation:wandering-eyes-move 10s infinite,wandering-eyes-blink 10s infinite',
        ].join(';')
        eye.replaceWith(span)
      }
      return
    }

    const eyeEls = Array.from(container.querySelectorAll<HTMLElement>('.we-eye'))
    const inners = Array.from(container.querySelectorAll<HTMLElement>('.we-inner'))

    function onMove(e: MouseEvent) {
      for (let i = 0; i < eyeEls.length; i++) {
        const rect = eyeEls[i].getBoundingClientRect()
        const cx = rect.left + rect.width / 2
        const cy = rect.top + rect.height / 2
        const angle = Math.atan2(e.clientY - cy, e.clientX - cx) * (180 / Math.PI)
        animate(inners[i], { rotate: angle + 90 }, { type: 'spring', stiffness: 300, damping: 20 })
      }
    }

    window.addEventListener('mousemove', onMove)

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('mousemove', onMove)
    }, { once: true })
  }

  initWanderingEyes()
  document.addEventListener('astro:page-load', initWanderingEyes)
</script>
