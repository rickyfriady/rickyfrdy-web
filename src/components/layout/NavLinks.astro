---
const { pathname } = Astro.url

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/resume', label: 'Resume' },
  { href: '/projects', label: 'Projects' },
  { href: '/board', label: 'Board' },
  { href: '/contact', label: 'Contact' },
] as const

function isActive(href: string): boolean {
  return href === '/' ? pathname === '/' : pathname.startsWith(href)
}

function setBackgroundColor(active: boolean): string {
  return active ? 'text-foreground' : 'text-muted hover:text-foreground'
}

---

<ul class="hidden items-center gap-1 md:flex">
  {navLinks.map(({ href, label }) => {
    const active = isActive(href)
    return (
      <li>
        <a
          href={href}
          class:list={[
            'menu-cursor relative inline-flex items-center px-3 py-2 font-mono text-[0.7rem] tracking-widest uppercase transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2',
            setBackgroundColor(active),
          ]}
        >
          {active && (
            <span
              transition:name="nav-active-pill"
              class="nav-island-pill"
              aria-hidden="true"
            />
          )}
          <span class="relative z-10">{label}</span>
        </a>
      </li>
    )
  })}
</ul>
