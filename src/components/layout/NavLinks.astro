---
import { isIdPath, localizePath, stripLocale } from '@/i18n/path'
import { t, type UIKey } from '@/i18n/ui'

const { pathname } = Astro.url
const lang = isIdPath(pathname) ? 'id' : 'en'
// The page's path without its locale, so `/id/about` is active for `/about`.
const path = stripLocale(pathname)

const navLinks: readonly { href: string; key: UIKey }[] = [
  { href: '/', key: 'nav.home' },
  { href: '/about', key: 'nav.about' },
  { href: '/experience', key: 'nav.experience' },
  { href: '/dashboard', key: 'nav.dashboard' },
  { href: '/resume', key: 'nav.resume' },
  { href: '/projects', key: 'nav.projects' },
  { href: '/board', key: 'nav.board' },
  { href: '/contact', key: 'nav.contact' },
]

function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path.startsWith(href)
}

function setBackgroundColor(active: boolean): string {
  return active ? 'text-foreground' : 'text-muted hover:text-foreground'
}

---

<ul class="hidden items-center gap-1 xl:flex">
  {navLinks.map(({ href, key }) => {
    const active = isActive(href)
    return (
      <li>
        <a
          href={localizePath(href, lang)}
          class:list={[
            'menu-cursor relative inline-flex min-h-11 min-w-11 items-center justify-center px-3 font-mono text-[0.7rem] tracking-widest uppercase transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2',
            setBackgroundColor(active),
          ]}
        >
          {active && (
            <span
              transition:name="nav-active-pill"
              class="nav-island-pill"
              aria-hidden="true"
            />
          )}
          <span class="relative z-10">{t(lang, key)}</span>
        </a>
      </li>
    )
  })}
</ul>
