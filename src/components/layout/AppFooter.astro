---
const year = new Date().getFullYear()
---

<footer class="border-border border-t py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 text-center">
    <p class="text-muted font-mono text-xs">
      © {year} Ricki Friadi. Built with Astro &amp; Tailwind v4
    </p>
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      <a
        href="https://github.com/rickyfriady"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        GitHub ↗
      </a>
      <a
        href="https://www.linkedin.com/in/rickifriadi"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        LinkedIn ↗
      </a>
      <a
        href="/ask"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Ask
      </a>
      <a
        href="/now"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Now
      </a>
      <a
        href="/changelog"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Changelog
      </a>
      <a
        href="/arcade"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Arcade
      </a>
      <a
        href="/contact"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Contact
      </a>
    </div>
  </div>
</footer>
