---
import { alternatePath, isIdPath, localizePath } from '@/i18n/path'
import { t } from '@/i18n/ui'

const year = new Date().getFullYear()
const lang = isIdPath(Astro.url.pathname) ? 'id' : 'en'
const other = lang === 'id' ? 'en' : 'id'
---

<!-- Below `xl` the fixed bottom nav (81px, 14px up) sits over the page end; pb-28 keeps the footer links clear of it. -->
<footer class="border-border border-t pt-8 pb-28 xl:pb-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 text-center">
    <p class="text-muted font-mono text-xs">
      © {year} Ricki Friadi. {t(lang, 'footer.built')}
    </p>
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      <a
        href="https://github.com/rickyfriady"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        GitHub ↗
      </a>
      <a
        href="https://www.linkedin.com/in/rickifriadi"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        LinkedIn ↗
      </a>
      <a
        href={localizePath('/ask', lang)}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        {t(lang, 'nav.ask')}
      </a>
      <a
        href={localizePath('/now', lang)}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Now
      </a>
      <a
        href="/changelog"
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        Changelog
      </a>
      <a
        href={localizePath('/arcade', lang)}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        {t(lang, 'nav.arcade')}
      </a>
      <a
        href={localizePath('/contact', lang)}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        {t(lang, 'nav.contact')}
      </a>
      <!-- Plain links, so Resume and the other language are reachable with
           scripts blocked, where the bottom nav's More drawer cannot open. -->
      <a
        href={localizePath('/resume', lang)}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        {t(lang, 'nav.resume')}
      </a>
      <a
        href={alternatePath(Astro.url.pathname)}
        hreflang={other}
        lang={other}
        class="footer-link text-muted hover:text-accent font-mono text-xs transition-colors"
      >
        {t(lang, 'nav.language')}
      </a>
    </div>
  </div>
</footer>
