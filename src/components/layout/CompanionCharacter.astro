---
import { companionReactions } from '@/data/companion'
import { t } from '@/i18n/ui'
import { getSprite } from '@/utils/game/sprites'

interface Props {
  lang?: 'en' | 'id'
}

const { lang = 'en' } = Astro.props

/**
 * A pixel character that walks the side gutter of every page, beside the
 * content column and never over it. Where the gutter cannot hold it, it does
 * not render.
 *
 * Deliberately not an island. This mounts on all 37 routes, and hydrating a
 * framework everywhere to walk a sprite would be an unforced cost on exactly
 * the pages a recruiter reads. `transition:persist` keeps this node alive
 * across navigations, so the character carries its position over instead of
 * being born and killed on every click.
 *
 * The directive sits on the element, not on the `<CompanionCharacter />` tag in
 * the layout: on a component it compiles to nothing, and the persistence
 * silently does not happen. Verified in the served HTML — with the directive on
 * the component there is no `data-astro-transition-persist` attribute at all.
 */
const sprite = getSprite('companion-pet')

/**
 * How many frames the walk actually has, read from the sheet rather than
 * hard-coded, so recutting to a longer or shorter cycle is a change to
 * `scripts/cut-companion-sheet.mjs` and its registration, not to this file.
 */
const walk = sprite.sheet?.animations?.walk
const frameCount = walk ? walk.to - walk.from + 1 : 1
---

<!--
  Hidden until the script measures a gutter wide enough to hold it, so there is
  nothing on the page without JavaScript and nothing over the content column.
  Only the sprite and its bubble are decorative; the dismiss button is a real
  control, outside the aria-hidden part and after all page content in tab order.
-->
<div
  id="companion"
  transition:persist
  transition:name="companion"
  class="pointer-events-none fixed bottom-0 left-0 z-40 hidden h-16 w-full"
  data-art={sprite.url ?? ''}
  data-frame-w={sprite.sheet?.frameWidth ?? 32}
  data-frame-h={sprite.sheet?.frameHeight ?? 32}
  data-frames={frameCount}
>
  <div aria-hidden="true">
    <div
      data-bubble
      class="evidence-card absolute bottom-16 left-2 hidden px-2 py-1 font-mono text-label"
    >
    </div>
    <div data-actor class="absolute bottom-3 left-0 will-change-transform">
      <div data-body class="sprite-fb pixel-sprite" data-kind="actor"></div>
    </div>
  </div>

  <button
    type="button"
    data-dismiss
    aria-label={t(lang, 'companion.hide')}
    data-label-en={t('en', 'companion.hide')}
    data-label-id={t('id', 'companion.hide')}
    class="bg-background border-border text-muted hover:text-accent focus-visible:ring-accent pointer-events-auto absolute bottom-0 left-0 flex size-11 border-2 focus-visible:ring-inset items-center justify-center font-mono text-xs focus-visible:ring-2 focus-visible:outline-none"
  ><span aria-hidden="true">[×]</span></button>
</div>

<script
  is:inline
  type="application/json"
  id="companion-data"
  set:html={JSON.stringify(companionReactions)}
></script>

<script>
  import { isIdPath } from '@/i18n/path'
  import { companionDismissed, initGame, setCompanionDismissed } from '@/stores/game'

  const SPEED = 26 // px per second, a stroll, not a sprint
  const BOB_MS = 180
  const LANE_START = 48 // clear of the 44px dismiss button in the corner
  const EDGE = 8 // breathing room against the content column

  let raf = 0
  let root: HTMLElement | null = null
  let actor: HTMLElement | null = null
  let body: HTMLElement | null = null
  let bubble: HTMLElement | null = null
  let x = LANE_START
  let dir = 1
  let last = 0
  let elapsed = 0
  let art = ''
  let frameW = 32
  let frameH = 32
  let frameCount = 1

  const reduced = () =>
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  /** The empty strip left of the content column, measured, not assumed. */
  const gutter = () => document.getElementById('main-content')?.getBoundingClientRect().left ?? 0

  /** The furthest the sprite may walk and stay clear of the content column. */
  const laneEnd = () => gutter() - frameW - EDGE

  /** Room for the button and one sprite's stroll; below that it does not render. */
  const fits = () => typeof window !== 'undefined' && laneEnd() >= LANE_START

  function paint() {
    if (!actor || !body) return
    actor.style.transform = `translate3d(${Math.round(x)}px, 0, 0)`
    body.style.transform = dir > 0 ? '' : 'scaleX(-1)'
    if (art) {
      // One row, mirrored for direction: every frame of this sheet faces the
      // viewer, so there is no direction row to index, and the `scaleX(-1)`
      // above already carries leftward travel. The previous version offset
      // vertically by `frameW`, which only held while frames were square.
      const frame = Math.floor(elapsed / 140) % frameCount
      body.style.backgroundPosition = `${-frame * frameW}px 0px`
    } else {
      // No art: a one-pixel bob reads as a walk cycle without any drawing.
      body.style.marginBottom = Math.floor(elapsed / BOB_MS) % 2 === 0 ? '0px' : '2px'
    }
  }

  function step(now: number) {
    if (!root) return
    const dt = last ? Math.min(now - last, 100) : 0
    last = now
    elapsed += dt
    x += (dir * SPEED * dt) / 1000
    const limit = laneEnd()
    if (x > limit) {
      x = limit
      dir = -1
    } else if (x < LANE_START) {
      x = LANE_START
      dir = 1
    }
    paint()
    raf = requestAnimationFrame(step)
  }

  function stop() {
    if (raf) cancelAnimationFrame(raf)
    raf = 0
    last = 0
  }

  function start() {
    stop()
    x = Math.min(Math.max(x, LANE_START), Math.max(LANE_START, laneEnd()))
    if (!root || reduced() || !fits()) {
      paint()
      return
    }
    raf = requestAnimationFrame(step)
  }

  function showReaction() {
    if (!bubble) return
    const path = window.location.pathname.replace(/^\/id(?=\/|$)/, '') || '/'
    const key = path.length > 1 ? path.replace(/\/$/, '') : path
    const lang = isIdPath(window.location.pathname) ? 'id' : 'en'
    let map: Record<string, { en: string; id: string }> = {}
    try {
      map = JSON.parse(document.getElementById('companion-data')?.textContent ?? '{}')
    } catch {
      /* Unmapped route and a broken map look the same to the visitor: silence. */
    }
    const line = map[key]?.[lang]
    bubble.textContent = line ?? ''
    bubble.classList.toggle('hidden', !line)
  }

  function applyVisibility() {
    if (!root) return
    const shown = !companionDismissed.get() && fits()
    // The `hidden` class is the default; showing is the exception.
    root.style.display = shown ? 'block' : ''
    if (bubble) bubble.style.maxWidth = `${Math.max(0, gutter() - 2 * EDGE)}px`
    if (shown) start()
    else stop()
  }

  function init() {
    root = document.getElementById('companion')
    if (!root) return
    // Every lookup below is scoped to the companion's own root. The previous
    // change lost an afternoon to a document-wide query that painted an
    // unrelated component; that mistake is not repeated here.
    actor = root.querySelector<HTMLElement>('[data-actor]')
    body = root.querySelector<HTMLElement>('[data-body]')
    bubble = root.querySelector<HTMLElement>('[data-bubble]')
    art = root.dataset.art ?? ''
    frameW = Number(root.dataset.frameW ?? 32)
    frameH = Number(root.dataset.frameH ?? frameW)
    frameCount = Number(root.dataset.frames ?? 1)

    // Without a gutter the companion is `display: none` and `start()` refuses
    // to animate, so fetching the sheet there buys a download for something no
    // one sees.
    if (art && body && fits()) {
      // Verify the sheet actually decodes before dropping the drawn floor.
      // Removing `sprite-fb` first and loading second leaves a hole on the
      // page for as long as the request takes, and forever if it fails.
      const probe = new Image()
      probe.onload = () => {
        if (!body) return
        body.classList.remove('sprite-fb')
        body.style.width = `${frameW}px`
        body.style.height = `${frameH}px`
        body.style.backgroundImage = `url(${art})`
      }
      probe.onerror = () => {
        art = ''
      }
      probe.src = art
    }

    // The node persists across navigations, including EN to ID, so the
    // button's name follows the page it is on now.
    const dismiss = root.querySelector<HTMLButtonElement>('[data-dismiss]')
    const lang = isIdPath(window.location.pathname) ? 'id' : 'en'
    const label = lang === 'id' ? dismiss?.dataset.labelId : dismiss?.dataset.labelEn
    if (dismiss && label) dismiss.setAttribute('aria-label', label)

    if (!root.dataset.bound) {
      root.dataset.bound = '1'
      window.addEventListener('resize', applyVisibility)
      root.querySelector('[data-dismiss]')?.addEventListener('click', () => {
        setCompanionDismissed(true)
      })
      companionDismissed.subscribe(applyVisibility)
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') stop()
        else applyVisibility()
      })
    }

    initGame()
    showReaction()
    applyVisibility()
  }

  init()
  document.addEventListener('astro:page-load', init)
</script>
