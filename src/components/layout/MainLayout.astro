---
import { ClientRouter } from 'astro:transitions'
import AppFooter from './AppFooter.astro'
import AppHeader from './AppHeader.astro'
import BaseHead from './BaseHead.astro'
import CommandPalette from './CommandPalette.astro'
import CompanionCharacter from './CompanionCharacter.astro'
import MobileBottomNav from './MobileBottomNav.astro'
import '@/styles/global.css'

interface HreflangPair {
  lang: string
  href: string
}

interface Props {
  title: string
  description: string
  lang?: 'en' | 'id'
  ogImage?: string | undefined
  ogType?: string
  hreflangPairs?: HreflangPair[]
  schema?: Record<string, unknown>
}

const { title, description, lang = 'en', ogImage, ogType, hreflangPairs, schema } = Astro.props
---

<!doctype html>
<!--
  No theme class here: the script in BaseHead sets `dark` before first paint from
  the stored choice or the system preference, and a visitor without scripts gets
  the light palette instead of a forced dark one.
-->
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} lang={lang} ogType={ogType} hreflangPairs={hreflangPairs} schema={schema} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-background focus:font-medium focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2">
      Skip to main content
    </a>
    <AppHeader />

    <!-- impeccable-disable-next-line layout-transition -- Astro view-transition directive and a --nav-height calc, not a CSS height animation -->
    <main id="main-content" transition:name="page-content" class="flex-1 max-w-6xl mx-auto w-full pt-[calc(var(--nav-height)+1.5rem)]">
      <slot />
    </main>

    <AppFooter />

    <MobileBottomNav transition:persist />

    <CompanionCharacter lang={lang} />

    <CommandPalette />
  </body>
</html>
