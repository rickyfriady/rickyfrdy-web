---
import type { WakaTimeStats } from '@/models'

interface Props {
  stats: WakaTimeStats | null
}

const { stats } = Astro.props

const items = stats
  ? [
      { label: 'This week', value: stats.humanReadableTotal },
      { label: 'Daily avg', value: stats.humanReadableDailyAverage },
      {
        label: 'Best day',
        value: stats.bestDay
          ? `${stats.bestDay.text} on ${new Date(stats.bestDay.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`
          : 'N/A',
      },
    ]
  : []
---

{stats ? (
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    {items.map(({ label, value }) => (
      <div class="evidence-card rounded-xl px-4 py-4">
        <p class="font-mono text-[10px] tracking-[0.14em] text-muted uppercase mb-1">{label}</p>
        <p class="text-foreground text-lg font-semibold leading-tight">{value}</p>
      </div>
    ))}
  </div>
) : (
  <div class="evidence-card rounded-xl px-5 py-6 text-center">
    <p class="text-muted text-sm">
      WakaTime stats unavailable — set <code class="font-mono text-accent text-xs">WAKATIME_API_KEY</code> in your deploy environment.
    </p>
  </div>
)}
